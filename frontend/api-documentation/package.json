{
  "name": "api-documentation",
  "version": "0.1.0",
  "private": true,
  "description": "NDLA API Documentation",
  "type": "module",
  "main": "dist/server.js",
  "author": "ndla@knowit.no",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/NDLANO/ndla.git",
    "directory": "frontend/api-documentation"
  },
  "bugs": {
    "url": "https://github.com/NDLANO/ndla/issues"
  },
  "homepage": "https://github.com/NDLANO/ndla",
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/static && cp -R src/static/. dist/static/",
    "type-check": "tsc --noEmit",
    "lint-es": "eslint --cache --cache-strategy content --cache-location '.eslintcache/' --max-warnings=0 src",
    "format-check": "oxfmt --check",
    "format": "oxfmt --write",
    "dev": "vite-node --watch src/server.ts",
    "start": "OPENAPI_ENDPOINTS=$(kubectl --context test get configmap api-docs-openapi-endpoints -o json | jq -r .data.OPENAPI_ENDPOINTS) vite-node --watch src/server.ts",
    "watch:types": "tsc -w --preserveWatchOutput",
    "start-prod": "NODE_ENV=production node --enable-source-maps ./dist/server.js",
    "test": "vitest --run",
    "tdd": "vitest"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/dist/**"
        ]
      }
    }
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "catalog:",
    "swagger-ui-dist": "5.31.1",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "catalog:",
    "@types/swagger-ui-dist": "^3.30.6",
    "eslint": "catalog:",
    "eslint-config-ndla": "workspace:*",
    "oxfmt": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vite-node": "^6.0.0",
    "vitest": "catalog:"
  },
  "packageManager": "yarn@4.17.1+sha512.ccbfabf7d7b6b32075088be9386fb9a2e00bb6887ef07fa56effabc890a56d53da1ccc4128d62db245fcbd3961b236d75335bdf7d5320ed6eafb7588b7ad4697"
}
