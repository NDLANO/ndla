{
  "name": "api-documentation",
  "version": "0.1.0",
  "private": true,
  "description": "NDLA API Documentation",
  "type": "module",
  "main": "build/server.mjs",
  "author": "ndla@knowit.no",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/NDLANO/ndla.git",
    "directory": "frontend/api-documentation"
  },
  "bugs": {
    "url": "https://github.com/NDLANO/ndla/issues"
  },
  "homepage": "https://github.com/NDLANO/ndla",
  "scripts": {
    "lint:oxlint": "oxlint --deny-warnings -c ../oxlint.config.ts .",
    "lint:es": "eslint --max-warnings=0 --no-inline-config --no-error-on-unmatched-pattern src",
    "clean": "rm -rf build",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/server.ts",
    "build": "pnpm run clean && pnpm run type-check && pnpm run build:client && pnpm run build:server",
    "type-check": "tsc --noEmit",
    "dev": "vite-node --watch src/server.ts",
    "start": "OPENAPI_ENDPOINTS=$(kubectl --context test get configmap api-docs-openapi-endpoints -o json | jq -r .data.OPENAPI_ENDPOINTS) vite-node --watch src/server.ts",
    "watch:types": "tsc -w --preserveWatchOutput",
    "start-prod": "NODE_ENV=production node --enable-source-maps ./build/server.mjs",
    "test": "vitest --run",
    "tdd": "vitest"
  },
  "nx": {
    "targets": {
      "lint": {},
      "build": {
        "outputs": [
          "{projectRoot}/build/**"
        ]
      }
    },
    "tags": [
      "releasable"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@ndla/server": "workspace:*",
    "@ndla/types-backend": "workspace:*",
    "@ndla/util": "workspace:*",
    "cors": "catalog:",
    "express": "catalog:",
    "openapi-fetch": "catalog:",
    "openid-client": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "swagger-ui-dist": "5.32.14",
    "swagger-ui-react": "5.32.14",
    "winston": "catalog:"
  },
  "devDependencies": {
    "@types/cors": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/swagger-ui-react": "^5.18.0",
    "eslint": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-node": "catalog:",
    "vitest": "catalog:"
  }
}
