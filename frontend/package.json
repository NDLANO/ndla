{
  "name": "@ndla/frontend-workspace",
  "private": true,
  "description": "NDLA frontend monorepo workspace (packages + apps + graphql-api)",
  "license": "GPL-3.0",
  "author": "ndla@knowit.no",
  "workspaces": [
    "packages",
    "packages/packages/*",
    "ndla-frontend",
    "editorial-frontend",
    "graphql-api"
  ],
  "scripts": {
    "prepare": "yarn workspace @ndla/preset-panda run prepare",
    "build:packages": "yarn prepare && nx run-many -t build prepublish --exclude=ndla-frontend,editorial-frontend,graphql-api",
    "check-all": "yarn nx run-many -t check-all",
    "watch:packages": "yarn workspace frontend-packages watch",
    "setup": "yarn install && yarn build:packages:types",
    "start:ed": "yarn workspace editorial-frontend start",
    "start:ndla": "yarn workspace ndla-frontend start",
    "dev:ndla": "yarn build:packages:types && concurrently -k -n packages,app 'yarn watch:packages' 'yarn start:ndla'",
    "dev:ed": "yarn build:packages:types && concurrently -k -n packages,app 'yarn watch:packages' 'yarn start:ed'",
    "graph": "nx graph"
  },
  "devDependencies": {
    "@ark-ui/react": "catalog:",
    "@babel/core": "^7.29.7",
    "@fontsource-variable/source-code-pro": "^5.2.7",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "@ndla/types-backend": "catalog:",
    "@pandacss/dev": "^1.10.0",
    "@storybook/addon-a11y": "^10.4.5",
    "@storybook/addon-docs": "^10.4.5",
    "@storybook/addon-links": "^10.4.5",
    "@storybook/react-vite": "^10.4.5",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "concurrently": "catalog:",
    "domhandler": "^6.0.1",
    "eslint": "catalog:",
    "html-react-parser": "catalog:",
    "htmlparser2": "^12.0.0",
    "i18next": "catalog:",
    "jsdom": "catalog:",
    "lerna": "^9.0.7",
    "nx": "22.7.5",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "^0.23.0",
    "postcss": "catalog:",
    "react": "catalog:",
