{
  "name": "@ndla/frontend-workspace",
  "private": true,
  "description": "NDLA frontend monorepo workspace (packages + apps + graphql-api)",
  "license": "GPL-3.0",
  "author": "ndla@knowit.no",
  "type": "module",
  "scripts": {
    "codegen": "nx run @ndla/preset-panda:codegen",
    "build:panda": "nx run-many -t build:panda",
    "check-all": "nx run-many -t type-check lint:oxlint lint:es format-check test",
    "lint-all": "nx run-many -t lint",
    "lint:oxlint": "oxlint --deny-warnings --ignore-pattern '*/**' .",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt -c .oxfmtrc.json",
    "format-check": "pnpm run format --check",
    "deps:check": "syncpack lint",
    "deps:fix": "syncpack fix",
    "dev:ndla": "nx dev ndla-frontend",
    "dev:ndla:gql": "LOCAL_GRAPHQL_API=true nx run-many -t dev -p graphql-api,ndla-frontend",
    "dev:ed": "nx dev editorial-frontend",
    "dev:ed:gql": "LOCAL_GRAPHQL_API=true nx run-many -t dev -p graphql-api,editorial-frontend",
    "dev:gql": "nx dev graphql-api",
    "dev:apidocs": "nx dev api-documentation",
    "dev:storybook": "nx dev frontend-packages",
    "graph": "nx graph"
  },
  "devDependencies": {
    "@ark-ui/react": "catalog:",
    "@fontsource-variable/source-code-pro": "catalog:",
    "@fontsource-variable/source-serif-4": "catalog:",
    "@graphql-eslint/eslint-plugin": "catalog:",
    "@ndla/types-backend": "workspace:*",
    "@pandacss/dev": "catalog:",
    "@sentry/vite-plugin": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-links": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "domhandler": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-import-x": "catalog:",
    "eslint-plugin-notice": "^1.0.0",
    "eslint-plugin-react": "catalog:",
    "html-react-parser": "catalog:",
    "htmlparser2": "catalog:",
    "i18next": "catalog:",
    "jsdom": "catalog:",
    "lerna": "^10.1.1",
    "nx": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "postcss": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "react-router": "catalog:",
    "slate": "catalog:",
    "slate-dom": "catalog:",
    "slate-history": "catalog:",
    "slate-react": "catalog:",
    "storybook": "catalog:",
    "svgo": "catalog:",
    "syncpack": "^15.3.3",
    "tsdown": "catalog:",
    "typescript": "catalog:ts6",
    "typescript-eslint": "catalog:",
    "typescript7": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
  "nx": {
    "name": "frontend-workspace",
    "implicitDependencies": [
      "*",
      "!frontend-workspace"
    ],
    "targets": {
      "lint": {},
      "lint:oxlint": {
        "inputs": [
          "workspaceRootScripts"
        ]
      }
    },
    "includedScripts": [
      "format",
      "format-check",
      "lint:oxlint"
    ]
  }
}
