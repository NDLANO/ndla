{
  "name": "@ndla/frontend-workspace",
  "private": true,
  "description": "NDLA frontend monorepo workspace (packages + apps + graphql-api)",
  "license": "GPL-3.0",
  "author": "ndla@knowit.no",
  "workspaces": [
    "packages",
    "packages/packages/*",
    "ndla-frontend",
    "editorial-frontend",
    "graphql-api"
  ],
  "scripts": {
    "prepare": "yarn nx run @ndla/preset-panda:prepare",
    "build:packages": "yarn nx run-many -t build build:types build:panda --exclude=ndla-frontend,editorial-frontend,graphql-api",
    "build:packages:affected": "yarn nx affected -t build build:types build:panda --exclude=ndla-frontend,editorial-frontend,graphql-api",
    "check-all": "yarn nx run-many -t type-check lint-es format-check test",
    "setup": "yarn install && yarn build:packages",
    "dev:ndla": "yarn nx dev ndla-frontend",
    "dev:ed": "yarn nx dev editorial-frontend",
    "dev:gql": "yarn nx dev graphql-api",
    "graph": "yarn nx graph"
  },
  "devDependencies": {
    "@ark-ui/react": "catalog:",
    "@babel/core": "^7.29.7",
    "@fontsource-variable/source-code-pro": "catalog:",
    "@fontsource-variable/source-serif-4": "catalog:",
    "@ndla/types-backend": "catalog:",
    "@pandacss/dev": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-links": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "domhandler": "catalog:",
    "eslint": "catalog:",
    "html-react-parser": "catalog:",
    "htmlparser2": "catalog:",
    "i18next": "catalog:",
    "jsdom": "catalog:",
    "lerna": "^9.0.7",
    "nx": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "^0.23.0",
    "postcss": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "react-router": "catalog:",
    "slate": "catalog:",
    "slate-dom": "catalog:",
    "slate-history": "catalog:",
    "slate-react": "catalog:",
    "storybook": "catalog:",
    "svgo": "^4.0.2",
    "syncpack": "^15.3.2",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "resolutions": {
    "@pandacss/config": "1.10.0",
    "@pandacss/core": "1.10.0",
    "@pandacss/dev": "^1.10.0",
    "@pandacss/extractor": "1.10.0",
    "@pandacss/generator": "1.10.0",
    "@pandacss/is-valid-prop": "1.10.0",
    "@pandacss/logger": "1.10.0",
    "@pandacss/mcp": "1.10.0",
    "@pandacss/node": "1.10.0",
    "@pandacss/parser": "1.10.0",
    "@pandacss/plugin-lightningcss": "1.10.0",
