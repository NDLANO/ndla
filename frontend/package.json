{
  "name": "@ndla/frontend-workspace",
  "private": true,
  "description": "NDLA frontend monorepo workspace (packages + apps + graphql-api)",
  "license": "GPL-3.0",
  "author": "ndla@knowit.no",
  "scripts": {
    "codegen": "nx run @ndla/preset-panda:codegen",
    "build:packages": "nx run-many -t build build:types build:panda --exclude=ndla-frontend,editorial-frontend,graphql-api,api-documentation",
    "build:packages:affected": "nx affected -t build build:types build:panda --exclude=ndla-frontend,editorial-frontend,graphql-api,api-documentation",
    "check-all": "nx run-many -t type-check lint-es format-check test",
    "format": "nx run-many -t format",
    "setup": "pnpm install && pnpm run build:packages",
    "dev:ndla": "nx dev ndla-frontend",
    "dev:ed": "nx dev editorial-frontend",
    "dev:gql": "nx dev graphql-api",
    "dev:apidocs": "nx dev api-documentation",
    "graph": "nx graph"
  },
  "devDependencies": {
    "@ark-ui/react": "catalog:",
    "@babel/core": "^7.29.7",
    "@fontsource-variable/source-code-pro": "^5.2.7",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "@ndla/types-backend": "workspace:*",
    "@pandacss/dev": "catalog:",
    "@storybook/addon-a11y": "^10.4.5",
    "@storybook/addon-docs": "^10.4.5",
    "@storybook/addon-links": "^10.4.5",
    "@storybook/react-vite": "^10.4.5",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "domhandler": "^6.0.1",
    "eslint": "catalog:",
    "html-react-parser": "catalog:",
    "htmlparser2": "^12.0.0",
    "i18next": "catalog:",
    "jsdom": "catalog:",
    "lerna": "^9.0.7",
    "nx": "22.7.5",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "^0.23.0",
    "postcss": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "react-router": "catalog:",
    "slate": "catalog:",
    "slate-dom": "catalog:",
    "slate-history": "catalog:",
    "slate-react": "catalog:",
    "storybook": "^10.4.5",
    "svgo": "^4.0.2",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
