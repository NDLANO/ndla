{
  "name": "mcp-server",
  "version": "1.0.0",
  "private": true,
  "description": "Open MCP server for NDLA learning resources",
  "license": "GPL-3.0",
  "author": "ndla@knowit.no",
  "type": "module",
  "main": "build/server.mjs",
  "scripts": {
    "lint:oxlint": "oxlint --deny-warnings -c ../oxlint.config.ts .",
    "lint:es": "eslint --max-warnings=0 --no-inline-config --no-error-on-unmatched-pattern src",
    "build": "rm -rf build && tsc --noEmit && vite build --ssr src/server.ts",
    "type-check": "tsc --noEmit",
    "dev": "vite-node --watch src/server.ts",
    "watch:types": "tsc -w --preserveWatchOutput",
    "start-prod": "NODE_ENV=production node --enable-source-maps ./build/server.mjs",
    "test": "vitest --run",
    "tdd": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "@ndla/shared": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "@prometheus-io/client": "^0.16.1",
    "cheerio": "catalog:",
    "cors": "catalog:",
    "express": "catalog:",
    "express-rate-limit": "^8.7.0",
    "hono": "^4.13.9",
    "lru-cache": "catalog:",
    "openapi-fetch": "catalog:",
    "turndown": "^7.2.4",
    "winston": "catalog:",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "@ndla/types-backend": "workspace:*",
    "@ndla/types-embed": "workspace:*",
    "@types/cors": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/turndown": "^5.0.6",
    "eslint": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-node": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "nx": {
    "targets": {
      "lint": {},
      "build": {
        "dependsOn": [],
        "outputs": [
          "{projectRoot}/build/**"
        ]
      }
    },
    "tags": [
      "releasable"
    ]
  }
}
