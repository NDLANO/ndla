{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.node.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsc/tsconfig.tsbuildinfo",
    "types": ["node", "vitest/globals"],
    "rootDir": "src"
  },
  "include": ["src/**/*"],
  "exclude": ["**/*-test.ts"]
}
