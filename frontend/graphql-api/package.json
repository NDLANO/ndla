{
  "name": "graphql-api",
  "version": "1.0.0",
  "private": true,
  "description": "NDLA GraphQL server",
  "license": "GPL-3.0",
  "author": "ndla@knowit.no",
  "type": "module",
  "main": "build/server.mjs",
  "scripts": {
    "lint:oxlint": "oxlint --deny-warnings -c ../oxlint.config.ts .",
    "lint:es": "eslint --max-warnings=0 --no-inline-config src",
    "build": "rm -rf build && vite build --ssr src/server.ts",
    "type-check": "tsc --noEmit",
    "generate-schema-types": "graphql-codegen --config codegen.ts",
    "dev": "vite-node --watch src/server.ts",
    "watch:types": "tsc -w --preserveWatchOutput",
    "start-prod": "NODE_ENV=production node --enable-source-maps ./build/server.mjs",
    "test": "vitest --run",
    "tdd": "vitest"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@googleapis/youtube": "catalog:",
    "@graphql-tools/schema": "^10.1.5",
    "@ndla/api-client": "workspace:*",
    "@ndla/licenses": "workspace:*",
    "@ndla/server": "workspace:*",
    "@ndla/shared": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "cheerio": "catalog:",
    "compression": "catalog:",
    "cors": "catalog:",
    "dataloader": "^2.2.3",
    "express": "catalog:",
    "graphql": "catalog:",
    "graphql-scalars": "^2.0.1",
    "graphql-tag": "catalog:",
    "he": "catalog:",
    "lodash": "^4.18.1",
    "lru-cache": "catalog:",
    "marked": "^18.0.14",
    "open-graph-scraper": "catalog:",
    "openapi-fetch": "catalog:",
    "oxfmt": "catalog:",
    "prismjs": "catalog:",
    "sanitize-html": "^2.17.7",
    "winston": "catalog:"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "catalog:",
    "@graphql-codegen/schema-ast": "catalog:",
    "@graphql-codegen/typescript-operations": "catalog:",
    "@graphql-codegen/typescript-resolvers": "^6.1.1",
    "@graphql-tools/mock": "^9.1.18",
    "@ndla/types-backend": "workspace:*",
    "@ndla/types-embed": "workspace:*",
    "@types/compression": "catalog:",
    "@types/cors": "catalog:",
    "@types/express": "catalog:",
    "@types/he": "catalog:",
    "@types/lodash": "^4.17.26",
    "@types/node": "catalog:",
    "@types/prismjs": "catalog:",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "catalog:",
    "openapi-typescript-helpers": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-node": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "nx": {
    "targets": {
      "lint": {},
      "generate-schema-types": {
        "inputs": [
          "{projectRoot}/codegen.ts",
          "{projectRoot}/src/schema.ts",
          "sharedGlobals"
        ],
        "outputs": [
          "{projectRoot}/src/types/schema.d.ts"
        ],
        "cache": true
      },
      "type-check": {
        "dependsOn": [
          "generate-schema-types"
        ]
      },
      "watch:types": {
        "dependsOn": [
          "...",
          "generate-schema-types"
        ]
      }
    },
    "tags": [
      "releasable"
    ]
  }
}
