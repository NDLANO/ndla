{
  "name": "graphql-api",
  "version": "1.0.0",
  "description": "NDLA GraphQL server",
  "type": "module",
  "main": "build/server.mjs",
  "author": "ndla@knowit.no",
  "license": "GPL-3.0",
  "private": true,
  "scripts": {
    "build": "rm -rf build && tsc --noEmit && vite build --ssr src/server.ts",
    "type-check": "tsc --noEmit",
    "lint-es": "eslint --cache --cache-strategy content --cache-location '.eslintcache/' --max-warnings=0 src",
    "format-check": "oxfmt --check",
    "format": "oxfmt --write",
    "generate-schema-types": "graphql-codegen --config codegen.ts && oxfmt --write src/types/schema.d.ts src/schema.ts",
    "dev": "node --watch --watch-path=src --watch-path=../packages/packages node_modules/vite-node/dist/cli.mjs src/server.ts",
    "watch:types": "tsc -w --preserveWatchOutput",
    "start-prod": "NODE_ENV=production node --enable-source-maps ./build/server.mjs",
    "test": "vitest --run",
    "tdd": "vitest"
  },
  "nx": {
    "targets": {
      "build": {
        "dependsOn": [],
        "outputs": [
          "{projectRoot}/build/**"
        ]
      }
    },
    "tags": [
      "releasable"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@googleapis/youtube": "catalog:",
    "@graphql-tools/schema": "^10.0.33",
    "@ndla/licenses": "workspace:*",
    "@ndla/server": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "cheerio": "catalog:",
    "compression": "catalog:",
    "cors": "catalog:",
    "dataloader": "^1.4.0",
    "express": "catalog:",
    "express-prom-bundle": "catalog:",
    "graphql": "catalog:",
    "graphql-scalars": "^1.25.0",
    "graphql-tag": "catalog:",
    "he": "catalog:",
    "ip-cidr": "^4.0.2",
    "lodash": "^4.18.1",
    "lru-cache": "catalog:",
    "marked": "^17.0.1",
    "open-graph-scraper": "catalog:",
    "openapi-fetch": "catalog:",
    "oxfmt": "catalog:",
    "prismjs": "catalog:",
    "prom-client": "catalog:",
    "punycode": "catalog:",
    "sanitize-html": "^2.17.0",
    "winston": "catalog:"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "catalog:",
    "@graphql-codegen/schema-ast": "catalog:",
    "@graphql-codegen/typescript-operations": "catalog:",
    "@graphql-codegen/typescript-resolvers": "^6.0.2",
    "@graphql-eslint/eslint-plugin": "catalog:",
    "@graphql-tools/mock": "^9.1.7",
    "@ndla/types-backend": "workspace:*",
    "@ndla/types-embed": "workspace:*",
    "@types/compression": "catalog:",
    "@types/cors": "catalog:",
    "@types/express": "catalog:",
    "@types/graphql": "^14.5.0",
    "@types/he": "catalog:",
    "@types/lodash": "^4.17.24",
    "@types/node": "catalog:",
    "@types/open-graph-scraper": "^5.2.3",
    "@types/prismjs": "catalog:",
    "@types/punycode": "catalog:",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "catalog:",
    "eslint-config-ndla": "workspace:*",
    "openapi-typescript-helpers": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vite-node": "catalog:",
    "vitest": "catalog:"
  }
}
