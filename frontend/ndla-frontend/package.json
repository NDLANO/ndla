{
  "name": "ndla-frontend",
  "version": "0.1.16",
  "description": "NDLA Frontend",
  "homepage": "https://github.com/NDLANO/ndla",
  "bugs": {
    "url": "https://github.com/NDLANO/ndla/issues"
  },
  "license": "GPL-3.0",
  "author": "ndla@knowit.no",
  "repository": {
    "type": "git",
    "url": "https://github.com/NDLANO/ndla.git",
    "directory": "frontend/ndla-frontend"
  },
  "type": "module",
  "scripts": {
    "build:client": "vite build --outDir build/public",
    "build:entrypoint": "vite build --ssr src/server/server.render.ts --outDir build/server",
    "build:server": "node scripts/build-server.mjs",
    "build": "yarn clean && yarn tsc && cross-env NODE_ENV=production yarn build:entrypoint && yarn build:client && yarn build:server",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf node_modules/.cache build",
    "test": "vitest --run",
    "tdd": "vitest",
    "lint-es": "eslint --cache --cache-strategy content --cache-location '.eslintcache/' --max-warnings=0 src e2e",
    "format": "oxfmt",
    "format-check": "oxfmt --check",
    "dev": "vite-node src/server.ts",
    "watch:types": "tsc -w --preserveWatchOutput",
    "start-without-ssr": "cross-env DISABLE_SSR=true yarn nx dev ndla-frontend",
    "start-with-local-graphql": "cross-env LOCAL_GRAPHQL_API=true yarn nx dev ndla-frontend",
    "start-prod": "cross-env NODE_ENV=production node build/server.js",
    "e2e": "playwright test --ui",
    "e2e:headless": "playwright test",
    "e2e:record": "DISABLE_CSP=true RECORD_FIXTURES=true playwright test --ui",
    "generate-gql": "graphql-codegen --config codegen.ts && oxfmt --write src/graphqlTypes.ts src/schema.graphql",
    "generate-gql:local": "GQL_SCHEMA='local' yarn generate-gql",
    "generate-gql:server": "GQL_SCHEMA='server' yarn generate-gql",
    "check-translations": "vitest --run src/messages/__tests__/"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/build/**"
        ]
      }
    }
  },
  "dependencies": {
    "@apollo/client": "4.2.3",
    "@ark-ui/react": "catalog:",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^8.0.0",
    "@dnd-kit/sortable": "9.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/source-code-pro": "^5.2.7",
    "@fontsource-variable/source-serif-4": "^5.2.9",
