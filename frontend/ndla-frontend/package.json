{
  "name": "ndla-frontend",
  "version": "0.1.16",
  "description": "NDLA Frontend",
  "homepage": "https://github.com/NDLANO/ndla",
  "bugs": {
    "url": "https://github.com/NDLANO/ndla/issues"
  },
  "license": "GPL-3.0",
  "author": "ndla@knowit.no",
  "repository": {
    "type": "git",
    "url": "https://github.com/NDLANO/ndla.git",
    "directory": "frontend/ndla-frontend"
  },
  "type": "module",
  "scripts": {
    "build:client": "vite build --outDir build/public",
    "build:entrypoint": "vite build --ssr src/server/server.render.ts --outDir build/server",
    "build:server": "node scripts/build-server.mjs",
    "build": "pnpm run clean && tsc && cross-env NODE_ENV=production pnpm run build:entrypoint && pnpm run build:client && pnpm run build:server",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf node_modules/.cache build",
    "test": "vitest --run",
    "tdd": "vitest",
    "lint-es": "eslint --cache --cache-strategy content --cache-location '.eslintcache/' --max-warnings=0 src e2e",
    "format": "oxfmt",
    "format-check": "oxfmt --check",
    "dev": "vite-node src/server.ts",
    "watch:types": "tsc -w --preserveWatchOutput",
    "start-without-ssr": "cross-env DISABLE_SSR=true nx dev ndla-frontend",
    "start-with-local-graphql": "cross-env LOCAL_GRAPHQL_API=true nx dev ndla-frontend",
    "start-prod": "cross-env NODE_ENV=production node build/server.js",
    "e2e": "playwright test --ui",
    "e2e:headless": "playwright test",
    "e2e:record": "DISABLE_CSP=true RECORD_FIXTURES=true playwright test --ui",
    "generate-gql": "graphql-codegen --config codegen.ts && oxfmt --write src/graphqlTypes.ts src/schema.graphql",
    "generate-gql:local": "GQL_SCHEMA=local pnpm run generate-gql",
    "generate-gql:server": "GQL_SCHEMA=server pnpm run generate-gql",
    "check-translations": "vitest --run src/messages/__tests__/"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/build/**"
        ]
      }
    }
  },
  "dependencies": {
    "@apollo/client": "4.2.3",
