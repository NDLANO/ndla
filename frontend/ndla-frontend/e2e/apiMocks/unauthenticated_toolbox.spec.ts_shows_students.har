__typename\":\"MetaImage\"},\"__typename\":\"Meta\"},\"context\":{\"contextId\":\"926159614b\",\"breadcrumbs\":[\"Verktøykassa – for elever\"],\"__typename\":\"TaxonomyContext\"},\"__typename\":\"Node\"},{\"id\":\"urn:topic:1:c84f9aad-c91f-4ce5-ad4f-f7755f45fbc6\",\"nodeType\":\"TOPIC\",\"name\":\"Læringsstrategier\",\"url\":\"/e/verktoykassa---for-elever/laringsstrategier/36af9c30b2\",\"relevanceId\":\"urn:relevance:core\",\"meta\":{\"metaDescription\":\"Her er noen tips til hvordan du kan lære deg å lære, og hvordan du husker det du har lært.\",\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/5020\",\"alt\":\"En jente og en gutt med skriveblokk og nettbrett. Foto.\",\"__typename\":\"MetaImage\"},\"__typename\":\"Meta\"},\"context\":{\"contextId\":\"36af9c30b2\",\"breadcrumbs\":[\"Verktøykassa – for elever\"],\"__typename\":\"TaxonomyContext\"},\"__typename\":\"Node\"},{\"id\":\"urn:topic:2:33316fa7-e6fc-455f-8344-6ffe45433269\",\"nodeType\":\"TOPIC\",\"name\":\"Vurdering og eksamen\",\"url\":\"/e/verktoykassa---for-elever/vurdering-og-eksamen/d505e7d264\",\"relevanceId\":\"urn:relevance:core\",\"meta\":{\"metaDescription\":\"Tips til gode vurderingsformer og til forberedelse og gjennomføring av eksamen i ulike fag.\",\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/48916\",\"alt\":\"Kvinne med PC. I forgrunnen symboler med tommel opp og tommel ned. Foto.\",\"__typename\":\"MetaImage\"},\"__typename\":\"Meta\"},\"context\":{\"contextId\":\"d505e7d264\",\"breadcrumbs\":[\"Verktøykassa – for elever\"],\"__typename\":\"TaxonomyContext\"},\"__typename\":\"Node\"},{\"id\":\"urn:topic:2:6dffd4d2-f450-422b-8fe4-e6d3c156613a\",\"nodeType\":\"TOPIC\",\"name\":\"Kommunikasjon, dialog og debatt\",\"url\":\"/e/verktoykassa---for-elever/kommunikasjon-dialog-og-debatt/fda63d996b\",\"relevanceId\":\"urn:relevance:core\",\"meta\":{\"metaDescription\":\"Tips til hvordan du kan gjøre deg forstått, til debattteknikk og til hvordan du kan bidra til gode dialoger.\",\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/43111\",\"alt\":\"Tegning av hva som foregår i hjernen til to personer som kommuniserer. Illustrasjon.\",\"__typename\":\"MetaImage\"},\"__typename\":\"Meta\"},\"context\":{\"contextId\":\"fda63d996b\",\"breadcrumbs\":[\"Verktøykassa – for elever\"],\"__typename\":\"TaxonomyContext\"},\"__typename\":\"Node\"},{\"id\":\"urn:topic:1:126f94e7-7b54-44b2-be7d-3edc1ca3d21e\",\"nodeType\":\"TOPIC\",\"name\":\"Idéutvikling og kreative metoder\",\"url\":\"/e/verktoykassa---for-elever/ideutvikling-og-kreative-metoder/5ea12d89f1\",\"relevanceId\":\"urn:relevance:core\",\"meta\":{\"metaDescription\":\"Tips til idéutvikling, idéformidling og kreative arbeidsmetoder for deg som ønsker å skape noe nytt.\",\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/43151\",\"alt\":\"Ungdom med ulike etnisitet foran en graffittivegg med tegning av en stor lyspære og andre idésymboler. Foto.\",\"__typename\":\"MetaImage\"},\"__typename\":\"Meta\"},\"context\":{\"contextId\":\"5ea12d89f1\",\"breadcrumbs\":[\"Verktøykassa – for elever\"],\"__typename\":\"TaxonomyContext\"},\"__typename\":\"Node\"},{\"id\":\"urn:topic:2:f18fdf58-0cc0-40dc-9a12-9dc43e30c96e\",\"nodeType\":\"TOPIC\",\"name\":\"Entreprenørskap\",\"url\":\"/e/verktoykassa---for-elever/entreprenorskap/549f9933c3\",\"relevanceId\":\"urn:relevance:core\",\"meta\":{\"metaDescription\":\"Tips til prosjektstyring, etablering av bedrifter og til pedagogisk entreprenørskap.\",\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/43961\",\"alt\":\"Tre ungdommer foran en glassvegg. Foto.\",\"__typename\":\"MetaImage\"},\"__typename\":\"Meta\"},\"context\":{\"contextId\":\"549f9933c3\",\"breadcrumbs\":[\"Verktøykassa – for elever\"],\"__typename\":\"TaxonomyContext\"},\"__typename\":\"Node\"},{\"id\":\"urn:topic:1:5c9abc7f-3b70-42d0-9362-2b4a7fe426a0\",\"nodeType\":\"TOPIC\",\"name\":\"Kritisk tenkning og kildekritikk\",\"url\":\"/e/verktoykassa---for-elever/kritisk-tenkning-og-kildekritikk/00ac87358a\",\"relevanceId\":\"urn:relevance:core\",\"meta\":{\"metaDescription\":\"Å kunne tenke kritisk og vurdere informasjon er en forutsetning når du skal utforske og utvikle kunnskap om ulike fenomener.\",\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/42692\",\"alt\":\"To personer samtaler med en globus i bakgrunnen. Illustrasjon.\",\"__typename\":\"MetaImage\"},\"__typename\":\"Meta\"},\"context\":{\"contextId\":\"00ac87358a\",\"breadcrumbs\":[\"Verktøykassa – for elever\"],\"__typename\":\"TaxonomyContext\"},\"__typename\":\"Node\"},{\"id\":\"urn:topic:2:432baee9-5671-47ce-870e-48b8fc3b7a42\",\"nodeType\":\"TOPIC\",\"name\":\"Metoder i utforskning\",\"url\":\"/e/verktoykassa---for-elever/metoder-i-utforskning/345c556f1a\",\"relevanceId\":\"urn:relevance:core\",\"meta\":{\"metaDescription\":\"En innføring i ulike metoder du kan bruke for å utforske et fenomen: observasjon, spørreundersøkelse, kildestudier, feltarbeid og statistisk analyse.\",\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/43962\",\"alt\":\"Stor hånd med forstørrelsesglass over en lang rekke mennesker i silhuett. Illustrasjon.\",\"__typename\":\"MetaImage\"},\"__typename\":\"Meta\"},\"context\":{\"contextId\":\"345c556f1a\",\"breadcrumbs\":[\"Verktøykassa – for elever\"],\"__typename\":\"TaxonomyContext\"},\"__typename\":\"Node\"},{\"id\":\"urn:topic:1:ffe4b637-1789-44fc-9c7e-ff69fd41652f\",\"nodeType\":\"TOPIC\",\"name\":\"Kildebruk og kildehenvisninger\",\"url\":\"/e/verktoykassa---for-elever/kildebruk-og-kildehenvisninger/985458317a\",\"relevanceId\":\"urn:relevance:core\",\"meta\":{\"metaDescription\":\"Her får du tips til hvordan du kan bruke kilder på en hensiktsmessig måte i eget arbeid.\",\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/42674\",\"alt\":\"Bøker og nettsider. Illustrasjon.\",\"__typename\":\"MetaImage\"},\"__typename\":\"Meta\"},\"context\":{\"contextId\":\"985458317a\",\"breadcrumbs\":[\"Verktøykassa – for elever\"],\"__typename\":\"TaxonomyContext\"},\"__typename\":\"Node\"},{\"id\":\"urn:topic:1:20029783-33c8-4364-a195-513071450017\",\"nodeType\":\"TOPIC\",\"name\":\"Dokumenter, rapporter og presenter\",\"url\":\"/e/verktoykassa---for-elever/dokumenter-rapporter-og-presenter/072bfc8198\",\"relevanceId\":\"urn:relevance:core\",\"meta\":{\"metaDescription\":\"Tips til hvordan du dokumenterer arbeidsoppdrag, både som skriftlige rapporter og muntlige presentasjoner.\",\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/45925\",\"alt\":\"Elever presentere ved hjelp av lysark på tavle. Foto.\",\"__typename\":\"MetaImage\"},\"__typename\":\"Meta\"},\"context\":{\"contextId\":\"072bfc8198\",\"breadcrumbs\":[\"Verktøykassa – for elever\"],\"__typename\":\"TaxonomyContext\"},\"__typename\":\"Node\"},{\"id\":\"urn:topic:2:20f8b41f-dbcb-4f41-9c53-193ef58db220\",\"nodeType\":\"TOPIC\",\"name\":\"Digitale verktøy\",\"url\":\"/e/verktoykassa---for-elever/digitale-verktoy/e968631620\",\"relevanceId\":\"urn:relevance:core\",\"meta\":{\"metaDescription\":\"Tips til noen digitale verktøy som du kan bruke i undervisning, i eget læringsarbeid og i samhandling med andre.\",\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/42674\",\"alt\":\"Skjerm og bøker. Illustrasjon.\",\"__typename\":\"MetaImage\"},\"__typename\":\"Meta\"},\"context\":{\"contextId\":\"e968631620\",\"breadcrumbs\":[\"Verktøykassa – for elever\"],\"__typename\":\"TaxonomyContext\"},\"__typename\":\"Node\"},{\"id\":\"urn:topic:c164d33a-2033-4c29-ad7b-19cba41f56b0\",\"nodeType\":\"TOPIC\",\"name\":\"Algoritmer og programmering (Python)\",\"url\":\"/e/verktoykassa---for-elever/algoritmer-og-programmering-python/303456e9ea\",\"relevanceId\":\"urn:relevance:core\",\"meta\":{\"metaDescription\":\"Her kan du øve på å tenke algoritmisk og å programmere i programmeringsspråket Python.\",\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/27334\",\"alt\":\" \",\"__typename\":\"MetaImage\"},\"__typename\":\"Meta\"},\"context\":{\"contextId\":\"303456e9ea\",\"breadcrumbs\":[\"Verktøykassa – for elever\"],\"__typename\":\"TaxonomyContext\"},\"__typename\":\"Node\"},{\"id\":\"urn:topic:2:de369d43-7380-460d-b80e-93f7f5631e36\",\"nodeType\":\"TOPIC\",\"name\":\"Datasikkerhet\",\"url\":\"/e/verktoykassa---for-elever/datasikkerhet/13672d2379\",\"relevanceId\":\"urn:relevance:core\",\"meta\":{\"metaDescription\":\"Din datasikkerhet er alltid under press. Det er mange farer og umulig å sikre seg helt, men det finnes kunnskap og tiltak som kan redusere risikoen.\",\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/48139\",\"alt\":\"Mennesker står i grupper som ser ut som jordas kontinenter. Illustrasjon\",\"__typename\":\"MetaImage\"},\"__typename\":\"Meta\"},\"context\":{\"contextId\":\"13672d2379\",\"breadcrumbs\":[\"Verktøykassa – for elever\"],\"__typename\":\"TaxonomyContext\"},\"__typename\":\"Node\"},{\"id\":\"urn:topic:fe9ce27d-2567-4125-a80e-e9441bb96e54\",\"nodeType\":\"TOPIC\",\"name\":\"Hva skal jeg bli?\",\"url\":\"/e/verktoykassa---for-elever/hva-skal-jeg-bli/f65fb2d96c\",\"relevanceId\":\"urn:relevance:core\",\"meta\":{\"metaDescription\":\"Se filmportretter og finn ut hvordan du kan utdanne deg til drømmejobben din.\",\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/4742\",\"alt\":\"Politimann på sykkel. Foto.\",\"__typename\":\"MetaImage\"},\"__typename\":\"Meta\"},\"context\":{\"contextId\":\"f65fb2d96c\",\"breadcrumbs\":[\"Verktøykassa – for elever\"],\"__typename\":\"TaxonomyContext\"},\"__typename\":\"Node\"}],\"subjectpage\":{\"id\":198,\"metaDescription\":\"Praktiske verktøy og råd for læringsarbeidet. \",\"about\":{\"title\":\"Verktøykassa – for elever\",\"visualElement\":{\"type\":\"image\",\"alt\":\"Gruppe mennesker som holder ark med spørsmålstegn foran ansikt. Foto.\",\"url\":\"https://images.test.ndla.no/id/45385\",\"imageUrl\":\"https://images.test.ndla.no/12552734.jpg\",\"imageLicense\":{\"id\":\"45385\",\"title\":\"En gruppe mennesker med spørsmålstegn foran ansiktene\",\"altTex