\",\"relevanceId\":\"urn:relevance:core\",\"resourceTypes\":[{\"id\":\"urn:resourcetype:subjectMaterial\",\"name\":\"Fagstoff\",\"__typename\":\"SearchContextResourceTypes\"}],\"__typename\":\"SearchContext\"},\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/48822\",\"alt\":\"Adam Bjerck på et kjøkken. Skjermdump.\",\"__typename\":\"MetaImage\"},\"traits\":[\"VIDEO\"],\"__typename\":\"ArticleSearchResult\"},{\"id\":\"22416\",\"title\":\"Hvordan skrive en profesjonell e-post?\",\"url\":\"/r/verktoykassa---for-elever/hvordan-skrive-en-profesjonell-e-post/0174152209\",\"metaDescription\":\"Hvordan kommunisere profesjonelt og vennlig på e-post? Se og lær av denne veiledningsvideoen.\",\"context\":{\"contextId\":\"0174152209\",\"relevanceId\":\"urn:relevance:core\",\"resourceTypes\":[{\"id\":\"urn:resourcetype:subjectMaterial\",\"name\":\"Fagstoff\",\"__typename\":\"SearchContextResourceTypes\"}],\"__typename\":\"SearchContext\"},\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/41218\",\"alt\":\"E-post-ikon svever over en laptop. Illustrasjon. \",\"__typename\":\"MetaImage\"},\"traits\":[\"VIDEO\"],\"__typename\":\"ArticleSearchResult\"},{\"id\":\"24112\",\"title\":\"Hva er stress?\",\"url\":\"/r/verktoykassa---for-elever/hva-er-stress/966096c5cf\",\"metaDescription\":\"Hva er forskjellen på positivt og negativt stress, og hvorfor kan ungdommer lett bli stressa?    \",\"context\":{\"contextId\":\"966096c5cf\",\"relevanceId\":\"urn:relevance:core\",\"resourceTypes\":[{\"id\":\"urn:resourcetype:tasksAndActivities\",\"name\":\"Oppgave\",\"__typename\":\"SearchContextResourceTypes\"}],\"__typename\":\"SearchContext\"},\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/50139\",\"alt\":\"En tenåringsgutt sitter foran PC-en, mens ei jente lener seg over skulderen hans. Foto.\",\"__typename\":\"MetaImage\"},\"traits\":[\"VIDEO\"],\"__typename\":\"ArticleSearchResult\"},{\"id\":\"25349\",\"title\":\"The Imitation Game\",\"url\":\"/r/verktoykassa---for-elever/the-imitation-game/5f493631b0\",\"metaDescription\":\"«The Imitation Game» forteller om Alan Turing og utviklingen av de første datamaskinene og knusingen av nazistenes Enigma-kode under andre verdenskrig.\",\"context\":{\"contextId\":\"5f493631b0\",\"relevanceId\":\"urn:relevance:core\",\"resourceTypes\":[{\"id\":\"urn:resourcetype:subjectMaterial\",\"name\":\"Fagstoff\",\"__typename\":\"SearchContextResourceTypes\"}],\"__typename\":\"SearchContext\"},\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/8628\",\"alt\":\"Alan Turing (spilt av Benedict Cumberbatch) står foran datamaskinen sin, som er flere meter stor og består av massevis av ledninger. Foto.\",\"__typename\":\"MetaImage\"},\"traits\":[\"VIDEO\"],\"__typename\":\"ArticleSearchResult\"},{\"id\":\"25639\",\"title\":\"Video: Bløff med statistikk\",\"url\":\"/r/verktoykassa---for-elever/video-bloff-med-statistikk/aa8cfff7ea\",\"metaDescription\":\"Denne videoen tar for seg viktige ting man bør være oppmerksom på når det gjelder statistikk.\",\"context\":{\"contextId\":\"aa8cfff7ea\",\"relevanceId\":\"urn:relevance:core\",\"resourceTypes\":[{\"id\":\"urn:resourcetype:tasksAndActivities\",\"name\":\"Oppgave\",\"__typename\":\"SearchContextResourceTypes\"}],\"__typename\":\"SearchContext\"},\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/51853\",\"alt\":\"To personer sitter. En har en regnsky svevende over seg. Over dem står ordene \\\"arbeidsledighet\\\", \\\"depresjon\\\" og \\\"fysisk sykdom\\\" med piler mellom. Illustrasjon.\",\"__typename\":\"MetaImage\"},\"traits\":[\"VIDEO\"],\"__typename\":\"ArticleSearchResult\"},{\"id\":\"16737\",\"title\":\"Vurdering av muntlig presentasjon\",\"url\":\"/r/verktoykassa---for-elever/vurdering-av-muntlig-presentasjon/2106956fae\",\"metaDescription\":\"Fagstoffside i norsk om vurdering av muntlige presentasjoner, med eksempel-video.\",\"context\":{\"contextId\":\"2106956fae\",\"relevanceId\":\"urn:relevance:core\",\"resourceTypes\":[{\"id\":\"urn:resourcetyp