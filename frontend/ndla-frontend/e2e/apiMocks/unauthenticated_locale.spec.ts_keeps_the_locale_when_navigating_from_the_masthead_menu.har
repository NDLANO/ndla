ot;image&quot;,&quot;embedData&quot;:{&quot;resource&quot;:&quot;image&quot;,&quot;resourceId&quot;:&quot;69995&quot;,&quot;size&quot;:&quot;full&quot;,&quot;align&quot;:&quot;&quot;,&quot;alt&quot;:&quot;Illustrasjon av tre personer som holder rundt hverandre. &quot;,&quot;caption&quot;:&quot;&quot;,&quot;hideByline&quot;:&quot;true&quot;,&quot;url&quot;:&quot;https://api.test.ndla.no/image-api/v2/images/69995&quot;,&quot;pageUrl&quot;:&quot;/image/69995&quot;},&quot;status&quot;:&quot;success&quot;,&quot;data&quot;:{&quot;id&quot;:&quot;69995&quot;,&quot;metaUrl&quot;:&quot;https://api.test.ndla.no/image-api/v3/images/69995&quot;,&quot;title&quot;:{&quot;title&quot;:&quot;Hvorfor bruke NDLA&quot;,&quot;language&quot;:&quot;nb&quot;},&quot;alttext&quot;:{&quot;alttext&quot;:&quot;Illustrasjon av tre personer som holder rundt hverandre. &quot;,&quot;language&quot;:&quot;nb&quot;},&quot;copyright&quot;:{&quot;license&quot;:{&quot;license&quot;:&quot;CC-BY-NC-ND-4.0&quot;,&quot;description&quot;:&quot;Creative Commons Attribution-NonCommercial-NoDerivs 4.0 International&quot;,&quot;url&quot;:&quot;https://creativecommons.org/licenses/by-nc-nd/4.0/&quot;},&quot;origin&quot;:&quot;NDLA&quot;,&quot;creators&quot;:[{&quot;type&quot;:&quot;originator&quot;,&quot;name&quot;:&quot;NDLA&quot;}],&quot;processors&quot;:[],&quot;rightsholders&quot;:[],&quot;processed&quot;:false},&quot;tags&quot;:{&quot;tags&quot;:[&quot;illusrasjon&quot;,&quot;illustrasjon&quot;,&quot;forside&quot;],&quot;language&quot;:&quot;nb&quot;},&quot;caption&quot;:{&quot;caption&quot;:&quot;&quot;,&quot;language&quot;:&quot;nb&quot;},&quot;supportedLanguages&quot;:[&quot;nb&quot;],&quot;created&quot;:&quot;2024-09-26T08:31:06.614Z&quot;,&quot;createdBy&quot;:&quot;83MTxOuvINMxC9o0km7P8cxp&quot;,&quot;modelRelease&quot;:&quot;not-applicable&quot;,&quot;image&quot;:{&quot;fileName&quot;:&quot;tplRmf6e.svg&quot;,&quot;size&quot;:29104,&quot;contentType&quot;:&quot;image/svg+xml&quot;,&quot;imageUrl&quot;:&quot;https://images.test.ndla.no/tplRmf6e.svg&quot;,&quot;variants&quot;:[],&quot;language&quot;:&quot;nb&quot;},&quot;inactive&quot;:false}}\\\"></ndlaembed></div><div data-type=\\\"grid-cell\\\"><ul><li><p>NDLA er en spydspiss i utviklingen av åpne digitale læringsressurser for videregående opplæring.</p></li><li><p>Ressursene våre er utviklet i samarbeid med dyktige lærere og elever.</p></li><li><p>Medarbeiderne våre har høy kompetanse.</p></li><li><p>Vi er alltid faglig oppdatert.</p></li><li><p>Nettstedet vårt er åpent for alle – hele døgnet, hele året.</p></li><li><p>Vi er ei viktig brikke i arbeidet med å nå FNs bærekraftsmål nummer fire: “Sikre inkluderende, rettferdig og god utdanning og fremme muligheter for livslang læring for alle.\\\"</p></li></ul><p><a href=\\\"https://ndla.no/\\\">Les mer om NDLA</a></p></div></div><h2 data-text=\\\"Våre nøkkeltall\\\">Våre nøkkeltall</h2><div data-type=\\\"grid\\\" data-columns=\\\"4\\\" data-border=\\\"none\\\"><div data-type=\\\"grid-cell\\\"><ndlaembed data-resource=\\\"key-figure\\\" data-title=\\\"24 000\\\" data-subtitle=\\\"Ressurser\\\" data-alt=\\\"\\\" data-json=\\\"{&quot;resource&quot;:&quot;key-figure&quot;,&quot;embedData&quot;:{&quot;resource&quot;:&quot;key-figure&quot;,&quot;title&quot;:&quot;24 000&quot;,&quot;subtitle&quot;:&quot;Ressurser&quot;,&quot;alt&quot;:&quot;&quot;},&quot;status&quot;:&quot;success&quot;,&quot;data&quot;:{}}\\\"></ndlaembed></div><div data-type=\\\"grid-cell\\\"><ndlaembed data-resource=\\\"key-figure\\\" data-title=\\\"14.8 Mill\\\" data-subtitle=\\\"BESØK I ÅR\\\" data-json=\\\"{&quot;resource&quot;:&quot;key-figure&quot;,&quot;embedData&quot;:{&quot;resource&quot;:&quot;key-figure&quot;,&quot;title&quot;:&quot;14.8 Mill&quot;,&quot;subtitle&quot;:&quot;BESØK I ÅR&quot;},&quot;status&quot;:&quot;success&quot;,&quot;data&quot;:{}}\\\"></ndlaembed></div><div data-type=\\\"grid-cell\\\"><ndlaembed data-resource=\\\"key-figure\\\" data-title=\\\"500\\\" data-subtitle=\\\"TVE