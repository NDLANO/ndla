relevanceId\":\"urn:relevance:core\",\"resourceTypes\":[{\"id\":\"urn:resourcetype:tasksAndActivities\",\"name\":\"Oppgave\",\"__typename\":\"SearchContextResourceTypes\"}],\"__typename\":\"SearchContext\"},\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/50139\",\"alt\":\"En tenåringsgutt sitter foran PC-en, mens ei jente lener seg over skulderen hans. Foto.\",\"__typename\":\"MetaImage\"},\"traits\":[\"VIDEO\"],\"__typename\":\"ArticleSearchResult\"},{\"id\":\"24290\",\"title\":\"Kjønn, seksualitet og kropp: Grensesetting\",\"url\":\"/r/verktoykassa---for-larere/kjonn-seksualitet-og-kropp-grensesetting/782239d29f\",\"metaDescription\":\"Hvordan sette grenser for din kropp og seksualitet?\",\"context\":{\"contextId\":\"782239d29f\",\"relevanceId\":\"urn:relevance:core\",\"resourceTypes\":[{\"id\":\"urn:resourcetype:subjectMaterial\",\"name\":\"Fagstoff\",\"__typename\":\"SearchContextResourceTypes\"}],\"__typename\":\"SearchContext\"},\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/50590\",\"alt\":\"Et par står tett sammen og holder rundt hverandre. Jenta holder en utløser i hånda. Foto. \",\"__typename\":\"MetaImage\"},\"traits\":[\"VIDEO\"],\"__typename\":\"ArticleSearchResult\"},{\"id\":\"25349\",\"title\":\"The Imitation Game\",\"url\":\"/r/verktoykassa---for-larere/the-imitation-game/24db9746c2\",\"metaDescription\":\"«The Imitation Game» forteller om Alan Turing og utviklingen av de første datamaskinene og knusingen av nazistenes Enigma-kode under andre verdenskrig.\",\"context\":{\"contextId\":\"24db9746c2\",\"relevanceId\":\"urn:relevance:core\",\"resourceTypes\":[{\"id\":\"urn:resourcetype:subjectMaterial\",\"name\":\"Fagstoff\",\"__typename\":\"SearchContextResourceTypes\"}],\"__typename\":\"SearchContext\"},\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/8628\",\"alt\":\"Alan Turing (spilt av Benedict Cumberbatch) står foran datamaskinen sin, som er flere meter stor og består av massevis av ledninger. Foto.\",\"__typename\":\"MetaImage\"},\"traits\":[\"VIDEO\"],\"__typename\":\"ArticleSearchResult\"},{\"id\":\"25639\",\"title\":\"Video: Bløff med statistikk\",\"url\":\"/r/verktoykassa---for-larere/video-bloff-med-statistikk/6f795fb821\",\"metaDescription\":\"Denne videoen tar for seg viktige ting man bør være oppmerksom på når det gjelder statistikk.\",\"context\":{\"contextId\":\"6f795fb821\",\"relevanceId\":\"urn:relevance:core\",\"resourceTypes\":[{\"id\":\"urn:resourcetype:tasksAndActivities\",\"name\":\"Oppgave\",\"__typename\":\"SearchContextResourceTypes\"}],\"__typename\":\"SearchContext\"},\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/51853\",\"alt\":\"To personer sitter. En har en regnsky svevende over seg. Over dem står ordene \\\"arbeidsledighet\\\", \\\"depresjon\\\" og \\\"fysisk sykdom\\\" med piler mellom. Illustrasjon.\",\"__typename\":\"MetaImage\"},\"traits\":[\"VIDEO\"],\"__typename\":\"ArticleSearchResult\"},{\"id\":\"26864\",\"title\":\"Film: Ulike perspektiver på bruk av AI-teknologi\",\"url\":\"/r/verktoykassa---for-larere/film-ulike-perspektiver-pa-bruk-av-ai-teknologi/8134be2a56\",\"metaDescription\":\"AI sies å være en teknologi som revolusjonerer datamaskinen. Hva vil det si? Og det sies at AI levendegjør roboter, men er ikke det bare en myte?\",\"context\":{\"contextId\":\"8134be2a56\",\"relevanceId\":\"urn:relevance:core\",\"resourceTypes\":[{\"id\":\"urn:resourcetype:subjectMaterial\",\"name\":\"Fagstoff\",\"__typename\":\"SearchContextResourceTypes\"}],\"__typename\":\"SearchContext\"},\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/53039\",\"alt\":\"Pikselerte bokstaver fader ut i svart. Grafisk.\",\"__typename\":\"MetaImage\"},\"traits\":[\"VIDEO\"],\"__typename\":\"ArticleSearchResult\"},{\"id\":\"29513\",\"title\":\"Ensomhet\",\"url\":\"/r/verktoykassa---for-larere/ensomhet/a1b6c95383\",\"metaDescription\":\"Mange unge kjenner på ensomhet, men ikke så mange snakker om det. Hva er egentlig ensomhet? Hvordan påvirker ensomhet oss, og hva kan vi gjøre med det?\",\"context\":{\"contextId\":\"a1b6c95383\",\"relevanceId\":\"urn:relevance:core\",\"resourceTypes\":[{\"id\":\"urn:resourcetype:subjectMaterial\",\"name\":\"Fagstoff\",\"__typename\":\"SearchContextResourceTypes\"}],\"__typename\":\"SearchContext\"},\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/55317\",\"alt\":\"En elev lener seg mot et bokskap og ser bort på fire andre ungdommer som står litt lenger borte og snakker og ler. Foto.\",\"__typename\":\"MetaImage\"},\"traits\":[\"VIDEO\"],\"__typename\":\"ArticleSearchResult\"},{\"id\":\"29368\",\"title\":\"Kunstig intelligens – gullgruve eller minefelt?\",\"url\":\"/r/verktoykassa---for-larere/kunstig-intelligens---gullgruve-eller-minefelt/2b43aa19a1\",\"metaDescription\":\"Refleksjons- og diskusjonsoppgave om kunstig intelligens, med utgangspunkt i dokumentaren 𝘪𝘏𝘜𝘔𝘈𝘕.\",\"context\":{\"contextId\":\"2b43aa19a1\",\"relevanceId\":\"urn:relevance:core\",\"resourceTypes\":[{\"id\":\"urn:resourcetype:tasksAndActivities\",\"name\":\"Oppgave\",\"__typename\":\"SearchContextResourceTypes\"}],\"__typename\":\"SearchContext\"},\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/49514\",\"alt\":\"En kunstig robothånd og en menneskelig hånd med pekefingrene mot hverandre. Illustrasjon. \",\"__typename\":\"MetaImage\"},\"traits\":[\"VIDEO\"],\"__typename\":\"ArticleSearchResult\"}],\"__typename\":\"Search\"}}}\n"},"headersSize":-1,"bodySize":-1,"redirectURL":""},"cache":{},"timings":{"send":-1,"wait":-1,"receive":10.812},"_resourceType":"fetch"}]}}
