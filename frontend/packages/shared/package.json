{
  "name": "@ndla/shared",
  "version": "1.0.0-alpha.0",
  "private": true,
  "description": "Shared utilities for NDLA's applications. Never published.",
  "license": "GPL-3.0",
  "author": "ndla@knowit.no",
  "repository": {
    "type": "git",
    "url": "https://github.com/NDLANO/ndla.git",
    "directory": "frontend/packages/packages/shared"
  },
  "type": "module",
  "sideEffects": [
    "./src/instrumentation.ts"
  ],
  "exports": {
    "./apiClient": {
      "ndla-source": "./src/apiClient/index.ts"
    },
    "./devReload": {
      "ndla-source": "./src/devReload.ts"
    },
    "./instrumentation": {
      "ndla-source": "./src/instrumentation.ts"
    },
    "./routes": {
      "ndla-source": "./src/routes/index.ts",
      "default": "./src/routes/index.ts"
    },
    "./routes/testUtils": {
      "ndla-source": "./src/routes/testUtils.ts"
    },
    "./sentry": {
      "ndla-source": "./src/sentry.ts"
    },
    "./server": {
      "ndla-source": "./src/server/index.ts"
    }
  },
  "dependencies": {
    "@ndla/types-backend": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/auto-instrumentations-node": "catalog:",
    "@opentelemetry/core": "catalog:",
    "@opentelemetry/exporter-trace-otlp-proto": "catalog:",
    "@opentelemetry/sdk-node": "catalog:",
    "@opentelemetry/sdk-trace": "catalog:",
    "@prometheus-io/client": "^0.16.1",
    "@react-router/dev": "catalog:",
    "@sentry/react": "catalog:",
    "express": "catalog:",
    "openapi-fetch": "catalog:",
    "openapi-typescript-helpers": "catalog:",
    "openid-client": "catalog:",
    "path-to-regexp": "^9.0.0",
    "react-router": "catalog:"
  },
  "devDependencies": {
    "@types/express": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-node": "catalog:",
    "vitest": "catalog:"
  }
}
