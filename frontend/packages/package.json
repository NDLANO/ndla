{
  "name": "frontend-packages",
  "private": true,
  "description": "NDLA Frontend Packages",
  "homepage": "https://github.com/NDLANO/ndla",
  "bugs": {
    "url": "https://github.com/NDLANO/ndla/issues"
  },
  "license": "GPL-3.0",
  "author": "ndla@knowit.no",
  "repository": {
    "type": "git",
    "url": "https://github.com/NDLANO/ndla.git",
    "directory": "frontend/packages"
  },
  "type": "module",
  "nx": {
    "implicitDependencies": [
      "@ndla/*"
    ],
    "includedScripts": [
      "type-check",
      "lint-es",
      "format-check",
      "test"
    ],
    "namedInputs": {
      "default": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/packages/packages/**/*",
        "sharedGlobals"
      ]
    },
    "targets": {
      "test": {
        "dependsOn": [
          {
            "projects": [
              "@ndla/preset-panda"
            ],
            "target": "prepare"
          }
        ]
      },
      "lint-es": {
        "outputs": []
      }
    }
  },
  "scripts": {
    "lint": "yarn format-check && yarn lint-es",
    "lint-es": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format-check": "oxfmt --check",
    "type-check": "tsc --noEmit",
    "watch:types": "tsc --noEmit -w --preserveWatchOutput",
    "test": "vitest --run",
    "clean": "rm -rf ./packages/*/dist ./packages/*/es ./packages/*/lib",
    "publish": "yarn clean && yarn packages-only -t build build:types build:panda --skip-nx-cache && lerna publish",
    "packages-only": "yarn nx run-many --exclude=ndla-frontend,editorial-frontend,graphql-api",
    "start": "storybook dev -p 6006 --no-open",
    "check-translations": "vitest --run 'packages/ui/src/locale/__tests__/'",
    "generate:icons": "node ./scripts/createTsIconComponents.mts"
  },
  "devDependencies": {
    "@pandacss/dev": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-links": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "domhandler": "catalog:",
    "html-react-parser": "catalog:",
    "htmlparser2": "catalog:",
    "i18next": "catalog:",
    "nx": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "react-router": "catalog:",
    "storybook": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@4.17.1+sha512.ccbfabf7d7b6b32075088be9386fb9a2e00bb6887ef07fa56effabc890a56d53da1ccc4128d62db245fcbd3961b236d75335bdf7d5320ed6eafb7588b7ad4697"
}
