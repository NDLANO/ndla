{
  "name": "frontend-packages",
  "private": true,
  "description": "NDLA Frontend Packages",
  "homepage": "https://github.com/NDLANO/ndla",
  "bugs": {
    "url": "https://github.com/NDLANO/ndla/issues"
  },
  "license": "GPL-3.0",
  "author": "ndla@knowit.no",
  "repository": {
    "type": "git",
    "url": "https://github.com/NDLANO/ndla.git",
    "directory": "frontend/packages"
  },
  "type": "module",
  "nx": {
    "implicitDependencies": [
      "@ndla/*"
    ],
    "includedScripts": [
      "type-check",
      "lint-es",
      "format",
      "format-check",
      "test"
    ],
    "namedInputs": {
      "default": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/packages/packages/**/*",
        "sharedGlobals"
      ]
    },
    "targets": {
      "test": {
        "dependsOn": [
          {
            "projects": [
              "@ndla/preset-panda"
            ],
            "target": "prepare"
          }
        ]
      },
      "lint-es": {
        "outputs": []
      }
    }
  },
  "scripts": {
    "lint": "pnpm run format-check && pnpm run lint-es",
    "lint-es": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format-check": "oxfmt --check",
    "type-check": "tsc --noEmit",
    "watch:types": "tsc --noEmit -w --preserveWatchOutput",
    "test": "vitest --run",
    "clean": "rm -rf ./packages/*/dist ./packages/*/es ./packages/*/lib",
    "publish": "pnpm run clean && pnpm run packages-only -t build build:types build:panda --skip-nx-cache && lerna publish",
    "packages-only": "nx run-many --exclude=ndla-frontend,editorial-frontend,graphql-api",
    "start": "storybook dev -p 6006 --no-open",
    "check-translations": "vitest --run 'packages/ui/src/locale/__tests__/'",
    "generate:icons": "node ./scripts/createTsIconComponents.mts"
  },
  "devDependencies": {
    "@internationalized/date": "3.12.2",
    "@ndla/article-converter": "workspace:^",
    "@ndla/audio-search": "workspace:^",
    "@ndla/core": "workspace:^",
    "@ndla/editor": "workspace:^",
    "@ndla/editor-components": "workspace:^",
    "@ndla/error-reporter": "workspace:^",
    "@ndla/hooks": "workspace:^",
    "@ndla/icons": "workspace:^",
    "@ndla/image-search": "workspace:^",
    "@ndla/licenses": "workspace:^",
    "@ndla/locales": "workspace:^",
    "@ndla/oxlint-config": "workspace:^",
    "@ndla/preset-panda": "workspace:^",
    "@ndla/primitives": "workspace:^",
    "@ndla/safelink": "workspace:^",
    "@ndla/server": "workspace:^",
    "@ndla/styled-system": "workspace:^",
    "@ndla/tracker": "workspace:^",
    "@ndla/types-backend": "workspace:^",
    "@ndla/types-embed": "workspace:^",
    "@ndla/ui": "workspace:^",
    "@ndla/util": "workspace:^",
    "@ndla/video-search": "workspace:^",
    "@pandacss/dev": "catalog:",
    "@storybook/addon-a11y": "^10.4.5",
    "@storybook/addon-docs": "^10.4.5",
    "@storybook/addon-links": "^10.4.5",
    "@storybook/react": "^10.4.5",
    "@storybook/react-vite": "^10.4.5",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "domhandler": "^6.0.1",
    "html-react-parser": "catalog:",
    "htmlparser2": "^12.0.0",
    "i18next": "catalog:",
    "nx": "22.7.5",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "react-router": "catalog:",
    "storybook": "^10.4.5",
    "svgo": "^4.0.2",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
