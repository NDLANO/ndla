    "editor",
    "slate",
    "ndla"
  ],
  "author": "ndla@knowit.no",
  "files": [
    "dist",
    "lib",
    "es",
    "types"
  ],
  "dependencies": {
    "@ark-ui/react": "catalog:",
    "@ndla/editor": "workspace:^",
    "@ndla/primitives": "workspace:^",
    "@ndla/styled-system": "workspace:^"
  },
  "peerDependencies": {
    "react": "catalog:peers",
    "react-dom": "catalog:peers",
    "slate": "catalog:peers",
    "slate-dom": "catalog:peers",
    "slate-history": "catalog:peers",
    "slate-react": "catalog:peers"
  },
  "devDependencies": {
    "@ndla/preset-panda": "workspace:^",
    "@pandacss/dev": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
