{
  "name": "@ndla/editor-components",
  "type": "module",
  "version": "0.0.87",
  "description": "Slate editor components for NDLA.",
  "license": "GPL-3.0",
  "exports": {
    "ndla-source": "./src/index.ts",
    "types": "./lib/index.d.ts",
    "import": "./es/index.mjs",
    "require": "./lib/index.js"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "watch:panda": "panda ship -w --outfile dist/panda.buildinfo.json",
    "build:types": "tsc -p tsconfig.build.json",
    "build:panda": "mkdir -p dist && panda cssgen --minimal --outfile dist/styles.css && panda ship --outfile dist/panda.buildinfo.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NDLANO/ndla.git",
    "directory": "frontend/packages/packages/editor-components"
  },
