{
  "name": "@ndla/preset-panda",
  "version": "0.0.78",
  "description": "Panda preset for NDLA.",
  "keywords": [
    "ndla",
    "panda",
    "preset"
  ],
  "license": "GPL-3.0",
  "author": "ndla@knowit.no",
  "repository": {
    "type": "git",
    "url": "https://github.com/NDLANO/ndla.git",
    "directory": "frontend/packages/packages/preset-panda"
  },
  "files": [
    "dist",
    "es",
    "lib"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "ndla-source": "./src/index.ts",
    "types": "./lib/index.d.ts",
    "import": "./es/index.mjs",
    "require": "./lib/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "codegen": "panda codegen",
    "build": "tsdown",
    "watch:codegen": "panda codegen -w",
    "watch:js": "tsdown --watch ./src",
    "build:types": "tsc -p tsconfig.build.json",
    "build:panda": "mkdir -p dist && panda cssgen --outfile dist/styles.css"
  },
  "dependencies": {
    "@ndla/core": "workspace:^",
    "@pandacss/dev": "catalog:"
  },
  "devDependencies": {
    "@ark-ui/react": "catalog:",
    "@ndla/styled-system": "workspace:^",
    "@pandacss/types": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
