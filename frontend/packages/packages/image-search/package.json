{
  "name": "@ndla/image-search",
  "version": "11.0.160-alpha.0",
  "gitHead": "ebeb8a1d86cba369e1156719ebaecb58a6e2cdfc",
  "description": "A simple library for searching images from NDLA",
  "keywords": [
    "ndla"
  ],
  "license": "GPL-3.0",
  "author": "ndla@knowit.no",
  "repository": {
    "type": "git",
    "url": "https://github.com/NDLANO/ndla.git",
    "directory": "frontend/packages/packages/image-search"
  },
  "files": [
    "dist",
    "lib",
    "es"
  ],
  "type": "module",
  "exports": {
    "ndla-source": "./src/index.ts",
    "types": "./lib/index.d.ts",
    "import": "./es/index.mjs",
    "require": "./lib/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "watch:panda": "panda ship -w --outfile dist/panda.buildinfo.json",
    "build:types": "tsc -p tsconfig.build.json",
    "build:panda": "mkdir -p dist && panda cssgen --minimal --outfile dist/styles.css && panda ship --outfile dist/panda.buildinfo.json"
  },
  "dependencies": {
    "@ndla/icons": "workspace:^",
    "@ndla/licenses": "workspace:^",
    "@ndla/primitives": "workspace:^",
    "@ndla/styled-system": "workspace:^",
    "@ndla/util": "workspace:^"
  },
  "devDependencies": {
    "@ndla/preset-panda": "workspace:^",
    "@ndla/types-backend": "workspace:^",
    "@pandacss/dev": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:peers",
    "react-dom": "catalog:peers"
  }
}
