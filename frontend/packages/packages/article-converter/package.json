    "react-i18next": "catalog:",
    "react-router": "catalog:"
  },
  "dependencies": {
    "@ndla/primitives": "workspace:^",
    "@ndla/safelink": "workspace:^",
    "@ndla/ui": "workspace:^",
    "html-react-parser": "catalog:"
  },
  "peerDependencies": {
    "i18next": ">= 25.0.0",
    "react": ">= 16.8.0",
    "react-dom": ">= 16.8.0",
