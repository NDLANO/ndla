{
  "name": "@ndla/core",
  "version": "6.0.7-alpha.0",
  "gitHead": "c2e2628a2dddfcca03f25548474243ffcd13595e",
  "description": "UI component library for NDLA.",
  "keywords": [
    "ndla"
  ],
  "license": "GPL-3.0",
  "author": "ndla@knowit.no",
  "repository": {
    "type": "git",
