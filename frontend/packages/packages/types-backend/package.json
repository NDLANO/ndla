{
  "name": "@ndla/types-backend",
  "version": "1.0.166",
  "description": "Typescript types and SDK for NDLA backend",
  "keywords": [
    "ndla"
  ],
  "license": "GPL-3.0",
  "author": "ndla@knowit.no",
  "repository": {
    "type": "git",
    "url": "https://github.com/NDLANO/ndla.git",
    "directory": "frontend/packages/packages/types-backend"
  },
  "files": [
    "lib",
    "es"
  ],
  "sideEffects": false,
  "exports": {
    "./*": {
      "ndla-source": "./src/*/index.ts",
      "types": "./lib/*/index.d.ts",
      "import": "./es/*/index.mjs",
      "require": "./lib/*/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "build:types": "tsc -p tsconfig.build.json",
    "generate": "tsx scripts/generate-openapi.mts"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:ts6"
  }
}
