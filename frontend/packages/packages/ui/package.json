{
  "name": "@ndla/ui",
  "type": "module",
  "version": "56.0.195-alpha.0",
  "description": "UI component library for NDLA",
  "license": "GPL-3.0",
  "exports": {
    "ndla-source": "./src/index.ts",
    "types": "./lib/index.d.ts",
    "import": "./es/index.mjs",
    "require": "./lib/index.js"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "watch:panda": "panda ship -w --outfile dist/panda.buildinfo.json",
    "build:types": "tsc -p tsconfig.build.json",
    "build:panda": "mkdir -p dist && panda cssgen --minimal --outfile dist/styles.css && panda ship --outfile dist/panda.buildinfo.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NDLANO/ndla.git",
    "directory": "frontend/packages/packages/ui"
  },
  "keywords": [
    "styleguide",
    "storybook",
    "ndla"
  ],
  "author": "ndla@knowit.no",
  "files": [
    "dist",
    "lib",
    "es",
    "types"
  ],
  "dependencies": {
    "@ark-ui/react": "catalog:",
    "@ndla/core": "workspace:^",
    "@ndla/icons": "workspace:^",
    "@ndla/licenses": "workspace:^",
    "@ndla/locales": "workspace:^",
    "@ndla/primitives": "workspace:^",
    "@ndla/safelink": "workspace:^",
    "@ndla/styled-system": "workspace:^",
    "@ndla/util": "workspace:^",
    "html-react-parser": "catalog:"
  },
  "peerDependencies": {
    "i18next": ">= 25.0.0",
    "react": ">= 18",
    "react-dom": ">= 18",
    "react-i18next": ">= 16",
    "react-router": ">= 7.0.0"
  },
  "devDependencies": {
    "@ndla/preset-panda": "workspace:^",
    "@ndla/types-backend": "catalog:",
    "@ndla/types-embed": "workspace:^",
    "@pandacss/dev": "catalog:",
    "i18next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "react-router": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
