{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "customConditions": ["ndla-source"],
    "noEmit": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "types": ["vitest/globals", "vite/client", "node"]
  },
  "include": ["./*/**/*"],
  "exclude": [
    "**/node_modules",
    "./*/lib",
    "./*/dist",
    "./*/es",
    "./*/tsdown.config.mts",
    "./ci",
    "./tasks",
    "./scripts"
  ]
}
