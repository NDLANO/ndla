{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "customConditions": ["ndla-source"],
    "noEmit": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "types": ["vitest/globals", "node", "@testing-library/jest-dom"]
  },
  "include": ["./packages/**/*", "./stories/**/*", "./dummydata/**/*", ".storybook/**/*"],
  "exclude": [
    "**/node_modules",
    "./packages/*/lib",
    "./packages/*/dist",
    "./packages/*/es",
    "./packages/*/tsdown.config.mts",
    "./packages/ci",
    "./packages/nx-mill"
  ]
}
