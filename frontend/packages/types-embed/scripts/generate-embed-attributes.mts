import { mkdir, readFile, writeFile } from "node:fs/promises";
import { dirname, join } from "node:path";

interface Validation {
  required?: boolean;
  dataType?: string;
  allowedValues?: string[];
}

interface Field {
  name: string;
  validation?: Validation;
}

interface EmbedTagRules {
  attributes: Record<string, { fields: Field[] }>;
}

const packageDir = join(import.meta.dirname, "..");
const rulesPath = join(packageDir, "../../../backend/validation/src/main/resources/embed-tag-rules.json");
const outputPath = join(packageDir, "src/generated/embedAttributes.ts");

const toKey = (attribute: string) =>
  attribute.replace("data-", "").replace(/(-|_)[a-z]/g, (m) => m.charAt(1).toUpperCase());

const toAttribute = (key: string) =>
  key === "resourceId" ? "data-resource_id" : `data-${key.replace(/[A-Z]/g, (m) => `-${m.toLowerCase()}`)}`;

const toTypeName = (resource: string) =>
  `${resource
    .split("-")
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join("")}EmbedAttributes`;

const toPropertyName = (name: string) => (/^[A-Za-z_$][\w$]*$/.test(name) ? name : JSON.stringify(name));

const toValueType = (resource: string, field: Field) => {
  if (field.name === "data-resource") return JSON.stringify(resource);
  const { dataType, allowedValues = [] } = field.validation ?? {};
  if (dataType === "ENUM") {
    if (!allowedValues.length) throw new Error(`${resource}.${field.name} is an ENUM without allowedValues`);
    return allowedValues.map((value) => JSON.stringify(value)).join(" | ");
  }
  if (dataType === "BOOLEAN") return `"true" | "false"`;
  return "string";
};

const toInterface = (resource: string, fields: Field[]) => {
  const resourceField = fields.find((field) => field.name === "data-resource");
  if (!resourceField) throw new Error(`${resource} is missing data-resource`);

  const seen = new Set<string>();
  const properties = [resourceField, ...fields.filter((field) => field !== resourceField)].map((field) => {
    const key = toKey(field.name);
    if (toAttribute(key) !== field.name) {
      throw new Error(`${resource}.${field.name} becomes "${key}", which serializes back to ${toAttribute(key)}`);
    }
    if (seen.has(key)) throw new Error(`${resource} has more than one attribute mapping to "${key}"`);
    seen.add(key);
    const optional = field.name === "data-resource" || field.validation?.required ? "" : "?";
    return `  ${key}${optional}: ${toValueType(resource, field)};`;
  });

  return `export interface ${toTypeName(resource)} {\n${properties.join("\n")}\n}`;
};

const rules: EmbedTagRules = JSON.parse(await readFile(rulesPath, "utf8"));
const entries = Object.entries(rules.attributes);

const output = [
  "// Generated by scripts/generate-embed-attributes.mts from backend/validation/src/main/resources/embed-tag-rules.json. Do not edit.",
  ...entries.map(([resource, { fields }]) => toInterface(resource, fields)),
  `export interface EmbedAttributesByResource {\n${entries
    .map(([resource]) => `  ${toPropertyName(resource)}: ${toTypeName(resource)};`)
    .join("\n")}\n}`,
  "export type EmbedResource = keyof EmbedAttributesByResource;",
  "export type EmbedAttributes = EmbedAttributesByResource[EmbedResource];",
].join("\n\n");

await mkdir(dirname(outputPath), { recursive: true });
await writeFile(outputPath, `${output}\n`);
