    "@googleapis/youtube": "catalog:",
    "@internationalized/date": "catalog:",
    "@ndla/article-converter": "workspace:*",
    "@ndla/audio-search": "workspace:*",
    "@ndla/editor": "workspace:*",
    "@ndla/editor-components": "workspace:*",
    "@ndla/hooks": "workspace:*",
    "@ndla/icons": "workspace:*",
    "@ndla/image-search": "workspace:*",
    "@ndla/licenses": "workspace:*",
    "@ndla/locales": "workspace:*",
    "@ndla/primitives": "workspace:*",
    "@ndla/safelink": "workspace:*",
