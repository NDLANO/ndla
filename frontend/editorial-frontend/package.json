{
  "name": "editorial-frontend",
  "version": "0.0.1",
  "description": "System for producing content for NDLA",
  "homepage": "https://github.com/NDLANO/ndla",
  "bugs": {
    "url": "https://github.com/NDLANO/ndla/issues"
  },
  "license": "GPL-3.0",
  "author": "ndla@knowit.no",
  "repository": {
    "type": "git",
    "url": "https://github.com/NDLANO/ndla.git",
    "directory": "frontend/editorial-frontend"
  },
  "type": "module",
  "scripts": {
    "lint:oxlint": "oxlint --deny-warnings -c ../oxlint.config.ts .",
    "lint:es": "eslint --max-warnings=0 --no-inline-config src",
    "build": "pnpm run clean && NODE_ENV=production react-router build",
    "typegen": "react-router typegen",
    "clean": "node scripts/clean.mjs",
    "type-check": "tsc --noEmit",
    "dev": "NODE_ENV=development vite-node src/server.ts",
    "watch:types": "tsc -w --preserveWatchOutput",
    "start-with-local-converter": "LOCAL_CONVERTER=true nx dev editorial-frontend",
    "start-prod": "NODE_ENV=production node --enable-source-maps build/server/index.js",
    "now-start": "NODE_ENV=production NOW=true node --enable-source-maps build/server/index.js",
    "test": "vitest --run",
    "tdd": "vitest",
    "e2e": "playwright test --ui",
    "e2e:headless": "playwright test",
    "e2e:record": "DISABLE_CSP=true RECORD_FIXTURES=true playwright test --ui",
    "check-translations": "vitest src/translations/__tests__/ --run"
  },
  "dependencies": {
    "@ark-ui/react": "catalog:",
    "@aws-sdk/client-bedrock-runtime": "^3.1157.0",
    "@aws-sdk/client-transcribe": "^3.1157.0",
