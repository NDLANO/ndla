  "browserslist": [
    "> 0.4%",
    "not dead"
  ],
  "engines": {
    "node": ">=24"
  },
  "nx": {
    "targets": {
      "lint:es": {
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/graphql-api/src/schema.ts"
        ]
      },
      "lint": {}
    },
    "tags": [
      "releasable"
    ]
  }
}
