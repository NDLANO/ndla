net (CloudFront)"}, {"name": "access-control-allow-origin", "value": "http://localhost:3000"}, {"name": "x-amz-cf-pop", "value": "ARN53-P3"}, {"name": "server", "value": "envoy"}], "content": {"size": 8504, "mimeType": "application/json", "compression": 38, "text": "{\"totalCount\":30,\"page\":1,\"pageSize\":10,\"language\":\"*\",\"results\":[{\"id\":38002,\"title\":{\"title\":\"Kontakt oss\",\"htmlTitle\":\"Kontakt oss\",\"language\":\"nb\"},\"introduction\":{\"introduction\":\"Har du sp\u00f8rsm\u00e5l, innspill, ros eller ris? Vi vil gjerne h\u00f8re fra deg!\",\"htmlIntroduction\":\"Har du sp\u00f8rsm\u00e5l, innspill, ros eller ris? Vi vil gjerne h\u00f8re fra deg!\",\"language\":\"nb\"},\"metaDescription\":{\"metaDescription\":\"Lurer du p\u00e5 noe? Ta kontakt med oss! \",\"language\":\"nb\"},\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/41225\",\"alt\":\"Person surfer p\u00e5 nettside p\u00e5 mobiltelefon. Foto.\",\"language\":\"nb\"},\"url\":\"https://api.test.ndla.no/article-api/v2/articles/38002\",\"license\":\"CC-BY-SA-4.0\",\"articleType\":\"frontpage-article\",\"lastUpdated\":\"2025-09-29T10:43:14.966Z\",\"supportedLanguages\":[\"nb\",\"nn\"],\"grepCodes\":[],\"availability\":\"everyone\",\"traits\":[]},{\"id\":38140,\"title\":{\"title\":\"Forside!\",\"htmlTitle\":\"Forside!\",\"language\":\"nb\"},\"introduction\":{\"introduction\":\"Ingress\",\"htmlIntroduction\":\"Ingress\",\"language\":\"nb\"},\"metaDescription\":{\"metaDescription\":\"Denne sida er forsida som skal brukes p\u00e5 test.ndla.no\",\"language\":\"nb\"},\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/55024\",\"alt\":\"forside\",\"language\":\"nb\"},\"url\":\"https://api.test.ndla.no/article-api/v2/articles/38140\",\"license\":\"CC-BY-SA-4.0\",\"articleType\":\"frontpage-article\",\"lastUpdated\":\"2026-06-16T11:41:23.470Z\",\"supportedLanguages\":[\"nb\",\"nn\",\"se\"],\"grepCodes\":[],\"availability\":\"everyone\",\"traits\":[\"VIDEO\"]},{\"id\":38149,\"title\":{\"title\":\"forside\",\"htmlTitle\":\"forside\",\"language\":\"nb\"},\"introduction\":{\"introduction\":\"Hei hei\",\"htmlIntroduction\":\"Hei hei\",\"language\":\"nb\"},\"metaDescription\":{\"metaDescription\":\"asdf\",\"language\":\"nb\"},\"url\":\"https://api.test.ndla.no/article-api/v2/articles/38149\",\"license\":\"CC-BY-SA-4.0\",\"articleType\":\"frontpage-article\",\"lastUpdated\":\"2023-08-22T11:27:30.037Z\",\"supportedLanguages\":[\"nb\",\"nn\",\"en\"],\"grepCodes\":[],\"availability\":\"everyone\",\"traits\":[]},{\"id\":38207,\"title\":{\"title\":\"Tester bilde i grid\",\"htmlTitle\":\"Tester bilde i grid\",\"language\":\"nb\"},\"introduction\":{\"introduction\":\"asdasda\",\"htmlIntroduction\":\"asdasda\",\"language\":\"nb\"},\"metaDescription\":{\"metaDescription\":\"sdf\",\"language\":\"nb\"},\"url\":\"https://api.test.ndla.no/article-api/v2/articles/38207\",\"license\":\"CC-BY-SA-4.0\",\"articleType\":\"frontpage-article\",\"lastUpdated\":\"2023-09-15T07:43:12.217Z\",\"supportedLanguages\":[\"nb\"],\"grepCodes\":[],\"availability\":\"everyone\",\"traits\":[\"PODCAST\",\"VIDEO\"]},{\"id\":38247,\"title\":{\"title\":\"Om NDLA\",\"htmlTitle\":\"Om NDLA\",\"language\":\"nb\"},\"visualElement\":{\"visualElement\":\"<ndlaembed data-resource=\\\"image\\\" data-resource_id=\\\"68333\\\" data-alt=\\\"Smilende jente sitter med \u00e5pen datamaskin foran seg. Foto.\\\" data-caption=\\\"\\\" data-is-decorative=\\\"false\\\" data-border=\\\"false\\\" data-upper-left-x=\\\"5.036830357142858\\\" data-upper-left-y=\\\"1.4438686313686313\\\" data-lower-right-x=\\\"53.03683035714286\\\" data-lower-right-y=\\\"51.44386863136863\\\" data-align=\\\"\\\" data-size=\\\"full\\\" data-hide-byline=\\\"true\\\"></ndlaembed>\",\"language\":\"nb\"},\"introduction\":{\"introduction\":\"P\u00e5 disse sidene inviterer vi deg til \u00e5 bli bedre kjent med Nasjonal digital l\u00e6ringsarena (NDLA); Norges ledende produsent av digitale l\u00e6ringsressurser for videreg\u00e5ende oppl\u00e6ring.\",\"htmlIntroduction\":\"P\u00e5 disse sidene inviterer vi deg til \u00e5 bli bedre kjent med Nasjonal digital l\u00e6ringsarena (NDLA); Norges ledende produsent av digitale l\u00e6ringsressurser for videreg\u00e5ende oppl\u00e6ring.\",\"language\":\"nb\"},\"metaDescription\":{\"metaDescription\":\"test\",\"language\":\"nb\"},\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/68333\",\"alt\":\"Smilende jente sitter med \u00e5pen datamaskin foran seg. Foto.\",\"language\":\"nb\"},\"url\":\"https://api.test.ndla.no/article-api/v2/articles/38247\",\"license\":\"CC-BY-SA-4.0\",\"articleType\":\"frontpage-article\",\"lastUpdated\":\"2026-01-15T13:48:24.936Z\",\"supportedLanguages\":[\"nb\",\"nn\"],\"grepCodes\":[],\"availability\":\"everyone\",\"traits\":[]},{\"id\":38252,\"title\":{\"title\":\"Ny forsideartikkel\",\"htmlTitle\":\"Ny forsideartikkel\",\"language\":\"nb\"},\"introduction\":{\"introduction\":\"Familien fr\u00e5 Hoverudbygda p\u00e5 vestsida av Strandefjorden i Nord-Aurdal blei r\u00e5ka av ras natt til tysdag. Fleire jordras gjekk rett gjennom garden deira og gjorde det umogleg \u00e5 kome seg ut fr\u00e5 omr\u00e5det.dfsg\",\"htmlIntroduction\":\"Familien fr\u00e5 Hoverudbygda p\u00e5 vestsida av Strandefjorden i Nord-Aurdal blei r\u00e5ka av ras natt til tysdag. Fleire jordras gjekk rett gjennom garden deira og gjorde det umogleg \u00e5 kome seg ut fr\u00e5 omr\u00e5det.dfsg\",\"language\":\"nb\"},\"metaDescription\":{\"metaDescription\":\"Dette er forsida til ndla\",\"language\":\"nb\"},\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/17845\",\"alt\":\"Forside metabilde\",\"language\":\"nb\"},\"url\":\"https://api.test.ndla.no/article-api/v2/articles/38252\",\"license\":\"CC-BY-SA-4.0\",\"articleType\":\"frontpage-article\",\"lastUpdated\":\"2023-08-31T13:23:26.656Z\",\"supportedLanguages\":[\"nb\",\"en\"],\"grepCodes\":[],\"availability\":\"everyone\",\"traits\":[\"VIDEO\"]},{\"id\":38253,\"title\":{\"title\":\"Hvem er vi?\",\"htmlTitle\":\"Hvem er vi?\",\"language\":\"nb\"},\"introduction\":{\"introduction\":\"NDLA er eit fylkeskommunalt samarbeid som tilbyr opne og fritt tilgjengelege l\u00e6remiddel for vidareg\u00e5ande oppl\u00e6ring. Medarbeidarane v\u00e5re har solid fagleg og digital kompetanse, og mange jobbar \u00f2g i vidareg\u00e5ande skule.\",\"htmlIntroduction\":\"NDLA er eit fylkeskommunalt samarbeid som tilbyr opne og fritt tilgjengelege l\u00e6remiddel for vidareg\u00e5ande oppl\u00e6ring. Medarbeidarane v\u00e5re har solid fagleg og digital kompetanse, og mange jobbar \u00f2g i vidareg\u00e5ande skule.\",\"language\":\"nb\"},\"metaDescription\":{\"metaDescription\":\"Grunnleggende informasjon om NDLA, Norges ledende produsent av digitale l\u00e6ringsressurser.\",\"language\":\"nb\"},\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/13611\",\"alt\":\"Personer med pc. Foto.\",\"language\":\"nb\"},\"url\":\"https://api.test.ndla.no/article-api/v2/articles/38253\",\"license\":\"CC-BY-SA-4.0\",\"articleType\":\"frontpage-article\",\"lastUpdated\":\"2025-09-29T13:08:48.468Z\",\"supportedLanguages\":[\"nb\",\"nn\"],\"grepCodes\":[],\"availability\":\"everyone\",\"traits\":[]},{\"id\":38259,\"title\":{\"title\":\"Jobb hos oss\",\"htmlTitle\":\"Jobb hos oss\",\"language\":\"nb\"},\"introduction\":{\"introduction\":\"NDLA skapes av dyktige l\u00e6rere som ofte kombinerer jobben i NDLA med undervisning i skolen. Et frikj\u00f8p for \u00e5 jobbe i NDLA er ei verdifull erfaring og gir deg nyttig kompetanseheving. Alle ansatte i eierfylkene v\u00e5re kan s\u00f8ke p\u00e5 utlyste stillinger.\",\"htmlIntroduction\":\"NDLA skapes av dyktige l\u00e6rere som ofte kombinerer jobben i NDLA med undervisning i skolen. Et frikj\u00f8p for \u00e5 jobbe i NDLA er ei verdifull erfaring og gir deg nyttig kompetanseheving. Alle ansatte i eierfylkene v\u00e5re kan s\u00f8ke p\u00e5 utlyste stillinger.\",\"language\":\"nb\"},\"metaDescription\":{\"metaDescription\":\"NDLA skapes av dyktige l\u00e6rere. Vil du v\u00e6re med p\u00e5 laget v\u00e5rt?\",\"language\":\"nb\"},\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/67745\",\"alt\":\"En gruppe mennesker som hopper\",\"language\":\"nb\"},\"url\":\"https://api.test.ndla.no/article-api/v2/articles/38259\",\"license\":\"CC-BY-SA-4.0\",\"articleType\":\"frontpage-article\",\"lastUpdated\":\"2025-09-29T13:09:50.597Z\",\"supportedLanguages\":[\"nb\",\"nn\"],\"grepCodes\":[],\"availability\":\"everyone\",\"traits\":[\"VIDEO\"]},{\"id\":38260,\"title\":{\"title\":\"Utlysninger\",\"htmlTitle\":\"Utlysninger\",\"language\":\"nb\"},\"introduction\":{\"introduction\":\"Lyst p\u00e5 kompetanseheving og nye utfordringer? Her publiserer vi ledige stillinger. F\u00f8lg med!\",\"htmlIntroduction\":\"Lyst p\u00e5 kompetanseheving og nye utfordringer? Her publiserer vi ledige stillinger. F\u00f8lg med!\",\"language\":\"nb\"},\"metaDescription\":{\"metaDescription\":\"Lyst p\u00e5 kompetanseheving og nye utfordringer? Her publiserer vi ledige stillinger. F\u00f8lg med!\",\"language\":\"nb\"},\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/45288\",\"alt\":\"L\u00e6rar hjelper elevar i klasserommet. Foto.\",\"language\":\"nb\"},\"url\":\"https://api.test.ndla.no/article-api/v2/articles/38260\",\"license\":\"CC-BY-SA-4.0\",\"articleType\":\"frontpage-article\",\"lastUpdated\":\"2025-09-29T10:41:20.144Z\",\"supportedLanguages\":[\"nb\",\"nn\"],\"grepCodes\":[],\"availability\":\"everyone\",\"traits\":[]},{\"id\":38261,\"title\":{\"title\":\"NDLAs historie\",\"htmlTitle\":\"NDLAs historie\",\"language\":\"nb\"},\"metaDescription\":{\"metaDescription\":\"test\",\"language\":\"nb\"},\"url\":\"https://api.test.ndla.no/article-api/v2/articles/38261\",\"license\":\"CC-BY-SA-4.0\",\"articleType\":\"frontpage-article\",\"lastUpdated\":\"2023-08-17T08:39:22.829Z\",\"supportedLanguages\":[\"nb\"],\"grepCodes\":[],\"availability\":\"everyone\",\"traits\":[]}]}"}, "headersSize": 732, "bodySize": 8466, "redirectURL": "", "_transferSi