e": "application/json", "compression": 38, "text": "{\"totalCount\":13,\"page\":1,\"pageSize\":13,\"language\":\"*\",\"results\":[{\"id\":38002,\"title\":{\"title\":\"Kontakt oss\",\"htmlTitle\":\"Kontakt oss\",\"language\":\"nb\"},\"introduction\":{\"introduction\":\"Har du sp\u00f8rsm\u00e5l, innspill, ros eller ris? Vi vil gjerne h\u00f8re fra deg!\",\"htmlIntroduction\":\"Har du sp\u00f8rsm\u00e5l, innspill, ros eller ris? Vi vil gjerne h\u00f8re fra deg!\",\"language\":\"nb\"},\"metaDescription\":{\"metaDescription\":\"Lurer du p\u00e5 noe? Ta kontakt med oss! \",\"language\":\"nb\"},\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/41225\",\"alt\":\"Person surfer p\u00e5 nettside p\u00e5 mobiltelefon. Foto.\",\"language\":\"nb\"},\"url\":\"https://api.test.ndla.no/article-api/v2/articles/38002\",\"license\":\"CC-BY-SA-4.0\",\"articleType\":\"frontpage-article\",\"lastUpdated\":\"2025-09-29T10:43:14.966Z\",\"supportedLanguages\":[\"nb\",\"nn\"],\"grepCodes\":[],\"availability\":\"everyone\",\"traits\":[]},{\"id\":38140,\"title\":{\"title\":\"Forside!\",\"htmlTitle\":\"Forside!\",\"language\":\"nb\"},\"introduction\":{\"introduction\":\"Ingress\",\"htmlIntroduction\":\"Ingress\",\"language\":\"nb\"},\"metaDescription\":{\"metaDescription\":\"Denne sida er forsida som skal brukes p\u00e5 test.ndla.no\",\"language\":\"nb\"},\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/55024\",\"alt\":\"forside\",\"language\":\"nb\"},\"url\":\"https://api.test.ndla.no/article-api/v2/articles/38140\",\"license\":\"CC-BY-SA-4.0\",\"articleType\":\"frontpage-article\",\"lastUpdated\":\"2026-06-16T11:41:23.470Z\",\"supportedLanguages\":[\"nb\",\"nn\",\"se\"],\"grepCodes\":[],\"availability\":\"everyone\",\"traits\":[\"VIDEO\"]},{\"id\":38247,\"title\":{\"title\":\"Om NDLA\",\"htmlTitle\":\"Om NDLA\",\"language\":\"nb\"},\"visualElement\":{\"visualElement\":\"<ndlaembed data-resource=\\\"image\\\" data-resource_id=\\\"68333\\\" data-alt=\\\"Smilende jente sitter med \u00e5pen datamaskin foran seg. Foto.\\\" data-caption=\\\"\\\" data-is-decorative=\\\"false\\\" data-border=\\\"false\\\" data-upper-left-x=\\\"5.036830357142858\\\" data-upper-left-y=\\\"1.4438686313686313\\\" data-lower-right-x=\\\"53.03683035714286\\\" data-lower-right-y=\\\"51.44386863136863\\\" data-align=\\\"\\\" data-size=\\\"full\\\" data-hide-byline=\\\"true\\\"></ndlaembed>\",\"language\":\"nb\"},\"introduction\":{\"introduction\":\"P\u00e5 disse sidene inviterer vi deg til \u00e5 bli bedre kjent med Nasjonal digital l\u00e6ringsarena (NDLA); Norges ledende produsent av digitale l\u00e6ringsressurser for videreg\u00e5ende oppl\u00e6ring.\",\"htmlIntroduction\":\"P\u00e5 disse sidene inviterer vi deg til \u00e5 bli bedre kjent med Nasjonal digital l\u00e6ringsarena (NDLA); Norges ledende produsent av digitale l\u00e6ringsressurser for videreg\u00e5ende oppl\u00e6ring.\",\"language\":\"nb\"},\"metaDescription\":{\"metaDescription\":\"test\",\"language\":\"nb\"},\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/68333\",\"alt\":\"Smilende jente sitter med \u00e5pen datamaskin foran seg. Foto.\",\"language\":\"nb\"},\"url\":\"https://api.test.ndla.no/article-api/v2/articles/38247\",\"license\":\"CC-BY-SA-4.0\",\"articleType\":\"frontpage-article\",\"lastUpdated\":\"2026-01-15T13:48:24.936Z\",\"supportedLanguages\":[\"nb\",\"nn\"],\"grepCodes\":[],\"availability\":\"everyone\",\"traits\":[]},{\"id\":38253,\"title\":{\"title\":\"Hvem er vi?\",\"htmlTitle\":\"Hvem er vi?\",\"language\":\"nb\"},\"introduction\":{\"introduction\":\"NDLA er eit fylkeskommunalt samarbeid som tilbyr opne og fritt tilgjengelege l\u00e6remiddel for vidareg\u00e5ande oppl\u00e6ring. Medarbeidarane v\u00e5re har solid fagleg og digital kompetanse, og mange jobbar \u00f2g i vidareg\u00e5ande skule.\",\"htmlIntroduction\":\"NDLA er eit fylkeskommunalt samarbeid som tilbyr opne og fritt tilgjengelege l\u00e6remiddel for vidareg\u00e5ande oppl\u00e6ring. Medarbeidarane v\u00e5re har solid fagleg og digital kompetanse, og mange jobbar \u00f2g i vidareg\u00e5ande skule.\",\"language\":\"nb\"},\"metaDescription\":{\"metaDescription\":\"Grunnleggende informasjon om NDLA, Norges ledende produsent av digitale l\u00e6ringsressurser.\",\"language\":\"nb\"},\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/13611\",\"alt\":\"Personer med pc. Foto.\",\"language\":\"nb\"},\"url\":\"https://api.test.ndla.no/article-api/v2/articles/38253\",\"license\":\"CC-BY-SA-4.0\",\"articleType\":\"frontpage-article\",\"lastUpdated\":\"2025-09-29T13:08:48.468Z\",\"supportedLanguages\":[\"nb\",\"nn\"],\"grepCodes\":[],\"availability\":\"everyone\",\"traits\":[]},{\"id\":38259,\"title\":{\"title\":\"Jobb hos oss\",\"htmlTitle\":\"Jobb hos oss\",\"language\":\"nb\"},\"introduction\":{\"introduction\":\"NDLA skapes av dyktige l\u00e6rere som ofte kombinerer jobben i NDLA med undervisning i skolen. Et frikj\u00f8p for \u00e5 jobbe i NDLA er ei verdifull erfaring og gir deg nyttig kompetanseheving. Alle ansatte i eierfylkene v\u00e5re kan s\u00f8ke p\u00e5 utlyste stillinger.\",\"htmlIntroduction\":\"NDLA skapes av dyktige l\u00e6rere som ofte kombinerer jobben i NDLA med undervisning i skolen. Et frikj\u00f8p for \u00e5 jobbe i NDLA er ei verdifull erfaring og gir deg nyttig kompetanseheving. Alle ansatte i eierfylkene v\u00e5re kan s\u00f8ke p\u00e5 utlyste stillinger.\",\"language\":\"nb\"},\"metaDescription\":{\"metaDescription\":\"NDLA skapes av dyktige l\u00e6rere. Vil du v\u00e6re med p\u00e5 laget v\u00e5rt?\",\"language\":\"nb\"},\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/67745\",\"alt\":\"En gruppe mennesker som hopper\",\"language\":\"nb\"},\"url\":\"https://api.test.ndla.no/article-api/v2/articles/38259\",\"license\":\"CC-BY-SA-4.0\",\"articleType\":\"frontpage-article\",\"lastUpdated\":\"2025-09-29T13:09:50.597Z\",\"supportedLanguages\":[\"nb\",\"nn\"],\"grepCodes\":[],\"availability\":\"everyone\",\"traits\":[\"VIDEO\"]},{\"id\":38260,\"title\":{\"title\":\"Utlysninger\",\"htmlTitle\":\"Utlysninger\",\"language\":\"nb\"},\"introduction\":{\"introduction\":\"Lyst p\u00e5 kompetanseheving og nye utfordringer? Her publiserer vi ledige stillinger. F\u00f8lg med!\",\"htmlIntroduction\":\"Lyst p\u00e5 kompetanseheving og nye utfordringer? Her publiserer vi ledige stillinger. F\u00f8lg med!\",\"language\":\"nb\"},\"metaDescription\":{\"metaDescription\":\"Lyst p\u00e5 kompetanseheving og nye utfordringer? Her publiserer vi ledige stillinger. F\u00f8lg med!\",\"language\":\"nb\"},\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/45288\",\"alt\":\"L\u00e6rar hjelper elevar i klasserommet. Foto.\",\"language\":\"nb\"},\"url\":\"https://api.test.ndla.no/article-api/v2/articles/38260\",\"license\":\"CC-BY-SA-4.0\",\"articleType\":\"frontpage-article\",\"lastUpdated\":\"2025-09-29T10:41:20.144Z\",\"supportedLanguages\":[\"nb\",\"nn\"],\"grepCodes\":[],\"availability\":\"everyone\",\"traits\":[]},{\"id\":38261,\"title\":{\"title\":\"NDLAs historie\",\"htmlTitle\":\"NDLAs historie\",\"language\":\"nb\"},\"metaDescription\":{\"metaDescription\":\"test\",\"language\":\"nb\"},\"url\":\"https://api.test.ndla.no/article-api/v2/articles/38261\",\"license\":\"CC-BY-SA-4.0\",\"articleType\":\"frontpage-article\",\"lastUpdated\":\"2023-08-17T08:39:22.829Z\",\"supportedLanguages\":[\"nb\"],\"grepCodes\":[],\"availability\":\"everyone\",\"traits\":[]},{\"id\":38603,\"title\":{\"title\":\"Demo - Ledig stilling som RSS-ansvarleg\",\"htmlTitle\":\"Demo - Ledig stilling som RSS-ansvarleg\",\"language\":\"nb\"},\"introduction\":{\"introduction\":\"Fiktiv stilling som RSS-ansvarlig - Den enkle m\u00e5ten \u00e5 holde seg oppdatert.\",\"htmlIntroduction\":\"Fiktiv stilling som RSS-ansvarlig - Den enkle m\u00e5ten \u00e5 holde seg oppdatert.\",\"language\":\"nb\"},\"metaDescription\":{\"metaDescription\":\"Fiktiv stilling som RSS-ansvarlig - Den enkle m\u00e5ten \u00e5 holde seg oppdatert.\",\"language\":\"nb\"},\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/29625\",\"alt\":\"RSS-logo. Illustrasjon.\",\"language\":\"nb\"},\"url\":\"https://api.test.ndla.no/article-api/v2/articles/38603\",\"license\":\"CC-BY-SA-4.0\",\"articleType\":\"frontpage-article\",\"lastUpdated\":\"2024-04-10T12:03:58.821Z\",\"supportedLanguages\":[\"nb\"],\"grepCodes\":[],\"availability\":\"everyone\",\"traits\":[]},{\"id\":42546,\"title\":{\"title\":\"Hva gj\u00f8r vi?\",\"htmlTitle\":\"Hva gj\u00f8r vi?\",\"language\":\"nb\"},\"introduction\":{\"introduction\":\"Oppgaven v\u00e5r er \u00e5 produsere \u00e5pne digitale l\u00e6ringsressurser for videreg\u00e5ende oppl\u00e6ring. Fagstoffet v\u00e5rt er faglig oppdatert, det foreligger p\u00e5 b\u00e5de nynorsk og bokm\u00e5l, og det meste er universelt utformet.\",\"htmlIntroduction\":\"Oppgaven v\u00e5r er \u00e5 produsere \u00e5pne digitale l\u00e6ringsressurser for videreg\u00e5ende oppl\u00e6ring. Fagstoffet v\u00e5rt er faglig oppdatert, det foreligger p\u00e5 b\u00e5de nynorsk og bokm\u00e5l, og det meste er universelt utformet.\",\"language\":\"nb\"},\"metaDescription\":{\"metaDescription\":\"Hva gj\u00f8r NDLA?\",\"language\":\"nb\"},\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/66051\",\"alt\":\"En l\u00e6rer st\u00e5r bak to elever for \u00e5 hjelpe til med en oppgave. Foto.\",\"language\":\"nb\"},\"url\":\"https://api.test.ndla.no/article-api/v2/articles/42546\",\"license\":\"CC-BY-SA-4.0\",\"articleType\":\"frontpage-article\",\"lastUpdated\":\"2025-09-29T10:28:24.109Z\",\"supportedLanguages\":[\"nb\",\"nn\"],\"grepCodes\":[],\"availability\":\"everyone\",\"traits\":[]},{\"id\":42584,\"title\":{\"title\":\"Bruke NDLA\",\"htmlTitle\":\"Bruke NDLA\",\"language\":\"nb\"},\"visualElement\":{\"visualElement\":\"<ndlaembed data-resource=\\\"image\\\" data-resource_id=\\\"41244\\\" data-size=\\\"full\\\" data-align=\\\"\\\" data-alt=\\\" \\\" data-caption=\\\" \\\" data-hide-byline=\\\"false\\\"></ndlaembed>\",\"language\":\"nb\"},\"introduction\":{\"introduction\":\"Hvordan kan du bruke NDLA? Vi har flere gode r\u00e5d og tips her\",\"htmlIntroduction\":\"Hvordan kan du bruke NDLA? Vi har flere gode r\u00e5d og tips her\",\"language\":\"nb\"},\"metaDescription\":{\"metaDescription\":\"Hvordan kan du bruke NDLA? Vi har flere gode r\u00e5d og tips her\",\"language\":\"nb\"},\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/41244\",\"alt\":\"Hvordan kan du bruke NDLA? Vi har flere gode r\u00e5d og tips her\",\"language\":\"nb\"},\"url\":\"https://api.test.ndla.no/article-api/v2/articles/42584\",\"license\":\"CC-BY-SA-4.0\",\"articleType\":\"frontpage-article\",\"lastUpdated\":\"2026-04-23T09:22:48.884Z\",\"supportedLanguages\":[\"nb\"],\"grepCodes\":[],\"availability\":\"everyone\",\"traits\":[]},{\"id\":42585,\"title\":{\"title\":\"Nye fag p\u00e5 NDLA\",\"htmlTitle\":\"Nye fag p\u00e5 NDLA\",\"language\":\"nb\"},\"visualElement\":{\"visualElement\":\"<ndlaembed data-resource=\\\"image\\\" data-resource_id=\\\"20582\\\" data-size=\\\"full\\\" data-align=\\\"\\\" data-alt=\\\"\\\" data-caption=\\\"\\\" data-hide-byline=\\\"true\\\"></ndlaembed>\",\"language\":\"nb\"},\"introduction\":{\"introduction\":\"Her kan du f\u00f8lge med p\u00e5 hvilke fag NDLA lager n\u00e5, og hvilke som kommer.\",\"htmlIntroduction\":\"Her kan du f\u00f8lge med p\u00e5 hvilke fag NDLA lager n\u00e5, og hvilke som kommer. \",\"language\":\"nb\"},\"metaDescription\":{\"metaDescription\":\"Her kan du f\u00f8lge med p\u00e5 hvilke fag NDLA lager n\u00e5, og hvilke som kommer. \",\"language\":\"nb\"},\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/41151\",\"alt\":\"\",\"language\":\"nb\"},\"url\":\"https://api.test.ndla.no/article-api/v2/articles/42585\",\"license\":\"CC-BY-SA-4.0\",\"articleType\":\"frontpage-article\",\"lastUpdated\":\"2026-04-23T09:27:35.670Z\",\"supportedLanguages\":[\"nb\"],\"grepCodes\":[],\"availability\":\"everyone\",\"traits\":[\"VIDEO\"]},{\"id\":42586,\"title\":{\"title\":\"Bruk Min NDLA f\u00f8r og under eksamen!\",\"htmlTitle\":\"Bruk Min NDLA f\u00f8r og under eksamen!\",\"language\":\"nb\"},\"visualElement\":{\"visualElement\":\"<ndlaembed data-resource=\\\"image\\\" data-resource_id=\\\"45288\\\" data-alt=\\\"L\u00e6rer hjelper elever i klassrommet. Foto. \\\" data-caption=\\\"\\\" data-is-decorative=\\\"false\\\" data-border=\\\"false\\\" data-align=\\\"\\\" data-size=\\\"full\\\" data-hide-byline=\\\"true\\\"></ndlaembed>\",\"language\":\"nb\"},\"introduction\":{\"introduction\":\"Visste du at NDLA er p\u00e5 lokale lister til eksamen? Du kan alts\u00e5 bruke l\u00e6restoffet og ogs\u00e5 lagre det p\u00e5 Min NDLA. Se en kort video om hvordan du lagrer dine favoritter.\",\"htmlIntroduction\":\"Visste du at NDLA er p\u00e5 lokale lister til eksamen? Du kan alts\u00e5 bruke l\u00e6restoffet og ogs\u00e5 lagre det p\u00e5 Min NDLA. Se en kort video om hvordan du lagrer dine favoritter.\",\"language\":\"nb\"},\"metaDescription\":{\"metaDescription\":\"Visste du at NDLA er p\u00e5 lokale lister til eksamen? Du kan alts\u00e5 bruke l\u00e6restoffet og ogs\u00e5 lagre det p\u00e5 Min NDLA. Se en kort video om hvordan du lagrer dine favoritter.\",\"language\":\"nb\"},\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/45288\",\"alt\":\"L\u00e6rer hjelper elever i klassrommet. Foto.\",\"language\":\"nb\"},\"url\":\"https://api.test.ndla.no/article-api/v2/articles/42586\",\"license\":\"CC-BY-SA-4.0\",\"articleType\":\"frontpage-article\",\"lastUpdated\":\"2026-04-23T09:32:44.699Z\",\"supportedLanguages\":[\"nb\"],\"grepCodes\":[],\"availability\":\"everyone\",\"traits\":[\"VIDEO\"]},{\"id\":42604,\"title\":{\"title\":\"Strategi mot 2032\",\"htmlTitle\":\"Strategi mot 2032\",\"language\":\"nb\"},\"visualElement\":{\"visualElement\":\"<ndlaembed data-resource=\\\"image\\\" data-resource_id=\\\"70039\\\" data-size=\\\"full\\\" data-align=\\\"\\\" data-alt=\\\"Smilende jente sitter med \u00e5pen datamaskin foran seg. Foto.\\\" data-caption=\\\"\\\" data-hide-byline=\\\"true\\\"></ndlaembed>\",\"language\":\"nb\"},\"introduction\":{\"introduction\":\"Fylkeskommunane har dei siste 20 \u00e5ra utvikla NDLA til det viktigaste strategiske verkt\u00f8yet for digital l\u00e6ring i vidareg\u00e5ande oppl\u00e6ring. Tala viser dette godt: I 2025 hadde ndla.no over 20 millionar bes\u00f8k, og vi leverer digitalt pedagogisk innhald til heile 143 eksamensfag.\",\"htmlIntroduction\":\"Fylkeskommunane har dei siste 20 \u00e5ra utvikla NDLA til det viktigaste strategiske verkt\u00f8yet for digital l\u00e6ring i vidareg\u00e5ande oppl\u00e6ring. Tala viser dette godt: I 2025 hadde ndla.no over 20 millionar bes\u00f8k, og vi leverer digitalt pedagogisk innhald til heile 143 eksamensfag.\",\"language\":\"nb\"},\"metaDescription\":{\"metaDescription\":\"NDLA sin strategi mot 2032: Eit klart m\u00e5l: \u00e5 vidareutvikle NDLA som ein trygg nasjonal l\u00e6ringsarena og vere den beste st\u00f8ttespelaren for l\u00e6raren\",\"language\":\"nb\"},\"metaImage\":{\"url\":\"https://images.test.ndla.no/id/70039\",\"alt\":\"Smilende jente sitter med \u00e5pen datamaskin foran seg. Foto.\",\"language\":\"nb\"},\"url\":\"https://api.test.ndla.no/article-api/v2/articles/42604\",\"license\":\"CC-BY-SA-4.0\",\"articleType\":\"frontpage-article\",\"lastUpdated\":\"2026-08-31T08:14:49.948Z\",\"supportedLanguages\":[\"nb\"],\"grepCodes\":[],\"availability\":\"everyone\",\"traits\":[]}]}"}, "headersSize": 732, "bodySize": 13449, "redirectURL": "", "_transferSize": 14181}, "cache": {}, "timings": {"dns": -1, "connect": -1, "ssl": -1, "send": 0, "wait": 201.958, "receive": 0.931}, "_frameref": "frame@f2d49cb816c9d2f5997645aa7734f504", "_monotonicTime": 1491.773, "_resourceType": "fetch", "_wasFulfilled": true, "_securityDetails": {}}, {"pageref": "page@41655080156a51a313611954d025a011", "startedDateTime": "2026-10-13T12:19:24.369Z", "time": 99.055, "request": {"method": "GET", "url": "https://api.test.ndla.no/article-api/v2/articles?articleTypes=frontpage-article