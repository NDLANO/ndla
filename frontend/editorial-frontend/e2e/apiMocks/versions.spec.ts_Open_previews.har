iv opplevelse hos kunden, får tilbakemelding og kan gi bedre informasjon til framtidige kunder</li></ul></section>\",\"language\":\"nb\",\"draftConcept\":true},\"operationName\":\"transformArticle\"}","params":[]}},"response":{"status":200,"statusText":"","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":"access-control-allow-origin","value":"http://localhost:3000"},{"name":"access-control-expose-headers","value":"*"},{"name":"cache-control","value":"no-store"},{"name":"content-encoding","value":"br"},{"name":"content-type","value":"application/json; charset=utf-8"},{"name":"date","value":"Wed, 09 Sep 2026 11:37:21 GMT"},{"name":"etag","value":"W/\"268e-CkK44uYbupBXwDzYhFBToXgBAWc\""},{"name":"server","value":"envoy"},{"name":"strict-transport-security","value":"max-age=31536000; includeSubDomains"},{"name":"vary","value":"Accept-Encoding"},{"name":"via","value":"1.1 a82071c7a558f0fabf37ee3b940ad600.cloudfront.net (CloudFront)"},{"name":"x-amz-cf-id","value":"slKM_3Zc2DFYJRn7RDVlyVSGswCGW66gtMaGd9yhfFlA4huEwNa9uA=="},{"name":"x-amz-cf-pop","value":"OSL50-P3"},{"name":"x-cache","value":"Miss from cloudfront"},{"name":"x-envoy-upstream-service-time","value":"22"},{"name":"x-powered-by","value":"Express"}],"content":{"size":-1,"mimeType":"application/json; charset=utf-8","text":"{\"data\":{\"transformArticleContent\":\"<section><p>CONTENTCONTENTCONTENTCONTENTCONTENTCONTENTCONTENTCONTENT</p><ndlaembed data-align=\\\"\\\" data-alt=\\\"Kunde med handleposer. Foto.\\\" data-caption=\\\"\\\" data-resource=\\\"image\\\" data-resource_id=\\\"23264\\\" data-size=\\\"full\\\" data-url=\\\"https://api.test.ndla.no/image-api/v2/images/23264\\\" data-json=\\\"{&quot;resource&quot;:&quot;image&quot;,&quot;embedData&quot;:{&quot;align&quot;:&quot;&quot;,&quot;alt&quot;:&quot;Kunde med handleposer. Foto.&quot;,&quot;caption&quot;:&quot;&quot;,&quot;resource&quot;:&quot;image&quot;,&quot;resourceId&quot;:&quot;23264&quot;,&quot;size&quot;:&quot;full&quot;,&quot;url&quot;:&quot;