package build.`dependency-graph`

import mill._, mill.scalalib._
import build.modules.sharedDependencies

object `package` extends ScalaModule {
  def scalaVersion: T[String] = Task {
    sharedDependencies().ScalaVersion
  }
  def mvnDeps: T[Seq[Dep]] = Task {
    val deps = sharedDependencies()
    import deps.*
    Seq(dep"org.scalameta::scalameta", dep"org.scalameta:semanticdb-shared_2.13")
  }
}
