package build.modules

import mill._, mill.scalalib._
import scala.util.Try

case class SharedDependencies(private val versions: Map[String, String]) {
  def version(coordinate: String): String = versions.getOrElse(
    coordinate,
    throw new NoSuchElementException(
      s"`$coordinate` has no version in versions.json. Known coordinates:\n  " +
        versions.keys.toSeq.sorted.mkString("\n  ")
    ),
  )

  extension (ctx: StringContext)
    def dep(): Dep = {
      val coordinate = ctx.parts.mkString
      Dep.parse(s"$coordinate:${version(coordinate)}")
    }

  val ScalaVersion: String = version("org.scala-lang:scala3-library_3")
  val ScalaTestV: String   = version("org.scalatest::scalatest")
  val KotlinV: String      = version("org.jetbrains.kotlin:kotlin-stdlib")

  def logging: Seq[Dep] = Seq(
    dep"org.apache.logging.log4j:log4j-api",
    dep"org.apache.logging.log4j:log4j-core",
    dep"org.apache.logging.log4j:log4j-jul",
    dep"org.apache.logging.log4j:log4j-slf4j2-impl",
    dep"com.typesafe.scala-logging::scala-logging",
    dep"org.slf4j:slf4j-api",
    // We need jackson to load `log4j2.yaml`
    dep"com.fasterxml.jackson.core:jackson-core",
    dep"com.fasterxml.jackson.core:jackson-databind",
    dep"com.fasterxml.jackson.dataformat:jackson-dataformat-yaml",
    dep"com.fasterxml.jackson.module::jackson-module-scala",
  )

  def testing: Seq[Dep] = Seq(
    dep"org.scalatest::scalatest",
    dep"org.scalatestplus::mockito-5-23",
    dep"org.testcontainers:testcontainers",
    dep"org.testcontainers:testcontainers-elasticsearch",
    dep"org.testcontainers:testcontainers-postgresql",
  )

  val scalikejdbc = dep"org.scalikejdbc::scalikejdbc"
  val postgres    = dep"org.postgresql:postgresql"
  val hikari      = dep"com.zaxxer:HikariCP"

  val flyway: Seq[Dep] = Seq(dep"org.flywaydb:flyway-core", dep"org.flywaydb:flyway-database-postgresql")

  def database: Seq[Dep] = Seq(scalikejdbc, postgres, hikari) ++ flyway

  def enumeratum: Seq[Dep] = Seq(dep"com.beachape::enumeratum", dep"com.beachape::enumeratum-circe")

  val sttp          = dep"com.softwaremill.sttp.client4::core"
  val awsS3         = dep"software.amazon.awssdk:s3"
  val awsTranscribe = dep"software.amazon.awssdk:transcribe"
  val awsSesV2      = dep"software.amazon.awssdk:sesv2"
  val awsCloudfront = dep"software.amazon.awssdk:cloudfront"

  val circe: Seq[Dep] = Seq(dep"io.circe::circe-generic", dep"io.circe::circe-literal", dep"io.circe::circe-parser")

  val tapirTesting: Dep = dep"com.softwaremill.sttp.tapir::tapir-testing"
  val tapir: Seq[Dep]   = Seq(
    dep"com.softwaremill.sttp.tapir::tapir-swagger-ui-bundle",
    dep"com.softwaremill.sttp.tapir::tapir-enumeratum",
    dep"com.softwaremill.sttp.tapir::tapir-json-circe",
    dep"com.softwaremill.sttp.tapir::tapir-netty-server-sync",
    dep"com.softwaremill.sttp.tapir::tapir-prometheus-metrics",
    dep"io.prometheus:prometheus-metrics-instrumentation-jvm",
    dep"io.prometheus:prometheus-metrics-simpleclient-bridge",
    dep"io.prometheus:simpleclient",
    dep"io.opentelemetry:opentelemetry-api",
    dep"com.softwaremill.sttp.apispec::openapi-circe-yaml",
  )

  val catsEffect: Dep = dep"org.typelevel::cats-effect"
  val catsCore: Dep   = dep"org.typelevel::cats-core"

  val tapirCirce: Seq[Dep] = circe ++ tapir

  def jedis: Dep            = dep"redis.clients:jedis"
  def jwtCirce: Dep         = dep"com.github.jwt-scala::jwt-circe"
  val nimbusOauth2Oidc: Dep = dep"com.nimbusds:oauth2-oidc-sdk"

  def jsoup: Dep    = dep"org.jsoup:jsoup"
  def scalaUri: Dep = dep"com.indoorvivants::scala-uri".exclude("org.typelevel" -> "cats-parse")

  def elastic4s: Dep     = dep"nl.gn0s1s::elastic4s-client-esjava"
  def elastic4sTest: Dep = dep"nl.gn0s1s::elastic4s-testkit"
  def jave: Seq[Dep]     = Seq(dep"ws.schild:jave-core", dep"ws.schild:jave-all-deps")

  def scrimage: Seq[Dep] = Seq(dep"com.sksamuel.scrimage:scrimage-core", dep"com.sksamuel.scrimage:scrimage-webp")

  def commonsIo: Dep = dep"commons-io:commons-io"

  // Spring Boot / taxonomy-api stack
  def springBootBoms: Seq[Dep] = Seq(dep"org.springframework.boot:spring-boot-dependencies")

  def springBootStarters: Seq[Dep] = Seq(
    mvn"org.springframework.boot:spring-boot-starter",
    mvn"org.springframework.boot:spring-boot-starter-web",
    mvn"org.springframework.boot:spring-boot-starter-validation",
    mvn"org.springframework.boot:spring-boot-starter-data-jpa",
    mvn"org.springframework.boot:spring-boot-starter-security",
    mvn"org.springframework.boot:spring-boot-starter-actuator",
    mvn"org.springframework.security:spring-security-web",
  )

  def taxonomyExtras: Seq[Dep] = Seq(
    dep"org.springdoc:springdoc-openapi-starter-webmvc-api".exclude("org.apache.commons" -> "commons-lang3"),
    mvn"org.postgresql:postgresql",
    mvn"org.liquibase:liquibase-core".exclude("org.apache.commons" -> "commons-lang3"),
    dep"net.lbruun.springboot:preliquibase-spring-boot-starter",
    dep"io.hypersistence:hypersistence-utils-hibernate-63",
    mvn"com.fasterxml.jackson.module:jackson-module-jakarta-xmlbind-annotations",
    mvn"com.fasterxml.jackson.datatype:jackson-datatype-jdk8",
    mvn"com.fasterxml.jackson.module:jackson-module-kotlin",
    dep"com.auth0:java-jwt",
    dep"com.auth0:jwks-rsa",
    dep"org.apache.commons:commons-lang3",
    mvn"commons-codec:commons-codec",
    dep"org.jsoup:jsoup",
    dep"net.bull.javamelody:javamelody-spring-boot-starter",
    mvn"io.micrometer:micrometer-registry-prometheus",
    mvn"ch.qos.logback:logback-core",
    dep"ch.qos.logback.contrib:logback-json-classic",
    dep"ch.qos.logback.contrib:logback-jackson",
    dep"org.jetbrains:annotations",
  )

  def springBootTest: Seq[Dep] = Seq(
    mvn"org.springframework.boot:spring-boot-starter-test",
    mvn"org.springframework.security:spring-security-test",
    dep"org.testcontainers:testcontainers-junit-jupiter".exclude("org.apache.commons" -> "commons-compress"),
    dep"org.testcontainers:testcontainers-postgresql",
    dep"org.testcontainers:testcontainers",
    dep"org.apache.commons:commons-compress".exclude("org.apache.commons" -> "commons-lang3"),
  )
}

object SharedDependencies {
  given rw: upickle.ReadWriter[SharedDependencies] = upickle.macroRW

  /** The separator renovate.json5 expects between group and artifact in each category it manages. */
  private val categorySeparators                                       = Map("dependencies" -> ":", "scalaDependencies" -> "::", "toolVersions" -> ":")
  private val scalaSuffix                                              = """_(?:3|2\.\d+)$""".r
  private def canonical(coordinate: String, separator: String): String = Try(Dep.parse(coordinate))
    .toOption
    .fold(s"group${separator}artifact") { dep =>
      val artifact =
        if (separator == "::") scalaSuffix.replaceFirstIn(dep.name, "")
        else dep.name
      s"${dep.organization}$separator$artifact"
    }

  def problems(categories: Map[String, Map[String, String]]): Seq[String] = {
    val unknown = (categories.keySet -- categorySeparators.keySet)
      .toSeq
      .sorted
      .map(category => s"category `$category` is not one renovate.json5 manages")

    val misshapen = for {
      (category, coordinates) <- categories.toSeq.sortBy(_._1)
      separator               <- categorySeparators.get(category).toSeq
      coordinate              <- coordinates.keys.toSeq.sorted
      canon                    = canonical(coordinate, separator)
      if canon != coordinate
    } yield s"`$coordinate` in `$category` must be written `$canon`"

    val written    = categories.values.flatMap(_.keys).toSeq
    val duplicated = written
      .diff(written.distinct)
      .distinct
      .sorted
      .map(coordinate => s"`$coordinate` is declared in more than one category")

    unknown ++ misshapen ++ duplicated
  }
}
