package build.modules

import mill.*
import mill.api.BuildCtx
import mill.api.Task.Simple.create
import mill.api.daemon.Result
import mill.scalalib.*
import mill.scalalib.scalafmt.ScalafmtModule
import mill.util.Tasks
import os.Path

import scala.util.{Failure, Success, Try}

trait OpenAPITSPlugin extends JavaModule {
  def moduleName: String
  def isComponent: Boolean = true

  private def typesBackend = build.modules.typescriptTypesBackend

  // Extra classpath entries to add when running the app with --generate-openapi.
  // Scala/tapir modules don't need anything beyond runClasspath; Java modules that rely
  // on test-scoped dependencies to boot (e.g. taxonomy-api's testcontainers JDBC driver)
  // override this to mix in their test classpath.
  def openApiExtraRunClasspath: T[Seq[PathRef]] = Task {
    Seq.empty[PathRef]
  }

  def generateTypescript: T[Unit] =
    if (isComponent) Task {
      typescript.outputFiles()()
    }
    else Task {
      Result.Success(())
    }

  object typescript extends Module {
    def generateOpenApiFiles: T[PathRef] = Task {
      Task.log.info(s"Generating OpenAPI file by calling $moduleName...")
      Try(
        runner().run(
          args = Args("--generate-openapi").value,
          mainClass = finalMainClass(),
          workingDir = Task.dest,
          extraRunClasspath = openApiExtraRunClasspath().map(_.path),
        )
      ) match {
        case Success(_) => ()
        case Failure(_) => Task.fail("Subprocess failed")
      }

      PathRef(Task.dest / s"$moduleName.json")
    }

    def generateTypeScriptFiles: T[PathRef] = Task {
      val _ = typesBackend.generator()

      val spec       = generateOpenApiFiles().path
      val outputFile = Task.dest / "src" / s"$moduleName.ts"
      os.copy.into(spec, Task.dest / "openapi", createFolders = true)

      Task.log.info(s"Generating TypeScript files for $moduleName...")
      Try(os.call(("pnpm", "run", "generate", spec, outputFile), cwd = typesBackend.packageDir)) match {
        case Success(_) => ()
        case Failure(e) =>
          e.printStackTrace()
          Task.fail(s"Generating TypeScript for $moduleName failed:\n${e.getMessage}")
      }

      PathRef(Task.dest)
    }

    def outputFiles(): Task.Command[Unit] = Task.Command {
      val generatedPath = generateTypeScriptFiles().path
      Seq(s"openapi/$moduleName.json", s"src/$moduleName.ts").foreach { pathStr =>
        val relativePath = os.SubPath(pathStr)
        os.copy(
          from = generatedPath / relativePath,
          to = typesBackend.packageDir / relativePath,
          followLinks = true,
          replaceExisting = true,
          copyAttributes = false,
          createFolders = true,
          mergeFolders = false,
        )
      }
    }
  }
}
