package build.modules

import mill.*
import mill.api.BuildCtx
import mill.scalalib.*
import mill.scalalib.scalafmt.ScalafmtModule
import mill.util.Tasks
import os.Path
import io.circe.parser.decode

import scala.util.{Failure, Success, Try}

trait BaseModule extends ScalaModule, ScalacOptions, AutoEnvLoading, OpenAPITSPlugin, CopyrightHeaderPlugin {
  def moduleName: String
  def dependencies(deps: SharedDependencies): Seq[Dep]
  override def mvnDeps: T[Seq[Dep]] = dependencies(sharedDependencies())
  def scalaVersion: T[String]       = sharedDependencies().ScalaVersion
  def test: TestBase
  private val baseModuleDir                  = super.moduleDir
  override def scalacOptions: T[Seq[String]] = super.scalacOptions() ++ sharedScalacOptions() ++ scalacOptionsOnlyRun()

  override def sources: T[Seq[PathRef]]   = Task.Sources("src/main/scala", "src/main/scala-3")
  override def resources: T[Seq[PathRef]] =
    Task.Sources("src/main/resources", BuildCtx.workspaceRoot / "log4j" / "main")

  override def forkArgs: T[Seq[String]] = super.forkArgs() ++ runtimeJavaOptions()

  def fmt(): Task.Command[Unit] = Task.Command {
    ScalafmtModule.reformatAll(Tasks(Seq(sources, test.sources)))()
  }

  trait TestBase extends ScalaTests, TestModule.ScalaTest {
    override def moduleDir: Path             = baseModuleDir / "src" / "test"
    override def scalaTestVersion: T[String] = sharedDependencies().ScalaTestV

    /** Dependencies the tests need on top of the shared testing ones. */
    def testDependencies(deps: SharedDependencies): Seq[Dep] = Nil

    override def mvnDeps: T[Seq[Dep]] = Task {
      val deps = sharedDependencies()
      super.mvnDeps() ++ deps.testing ++ testDependencies(deps)
    }

    override def sources: T[Seq[PathRef]]      = Task.Sources("scala", "scala-3")
    override def resources: T[Seq[PathRef]]    = Task.Sources("resources", BuildCtx.workspaceRoot / "log4j" / "test")
    override def scalacOptions: T[Seq[String]] = super.scalacOptions().filterNot(scalacOptionsOnlyRun().contains)
    override def forkArgs: T[Seq[String]]      = super.forkArgs() ++ runtimeJavaOptions() ++ testJavaOptions()
  }
}

object typescriptTypesBackend extends Module {
  def frontendRoot: Path          = BuildCtx.workspaceRoot / os.up / "frontend"
  def packageDir: Path            = frontendRoot / "packages" / "packages" / "types-backend"
  def nodeModulesDir: Path        = frontendRoot / "node_modules"
  def generatorScript: T[PathRef] = Task.Source(packageDir / "scripts" / "generate-openapi.ts")
  def lockfile: T[PathRef]        = Task.Source(frontendRoot / "pnpm-lock.yaml")

  /** Hash of pnpm's own record of what is linked into `node_modules`. Unlike a stamp Mill writes itself, this also
    * notices installs done outside Mill.
    */
  private def modulesStateHash: String = {
    val stateFile = nodeModulesDir / ".modules.yaml"
    if (os.exists(stateFile)) os.read(stateFile).hashCode.toString
    else "missing"
  }

  def installedState: T[String] = Task.Input {
    modulesStateHash
  }

  /** Installs the frontend workspace unless `node_modules` already holds the result of installing the current
    * `pnpm-lock.yaml`. Being one cached task, `_.generateTypescript` shares a single install across all services
    * instead of racing; the stamp is what keeps it from installing once more when [[installedState]] flips to its
    * post-install value.
    */
  def install: T[Unit] = Task(persistent = true) {
    val stamp   = Task.dest / "installed-state"
    val lockSig = lockfile().sig

    if (!os.exists(stamp) || os.read(stamp) != s"$lockSig-${installedState()}") {
      Task.log.info(s"Running `pnpm install --frozen-lockfile` in $frontendRoot...")
      Try(os.call(("pnpm", "install", "--frozen-lockfile"), cwd = frontendRoot, stdout = os.Inherit)) match {
        case Success(_) => os.write.over(stamp, s"$lockSig-$modulesStateHash")
        case Failure(e) => Task.fail(s"`pnpm install` in $frontendRoot failed:\n${e.getMessage}")
      }
    }
  }

  def generator: T[Seq[PathRef]] = Task {
    install()
    Seq(generatorScript(), lockfile())
  }
}

def versionsFile: T[PathRef]                  = Task.Source(BuildCtx.workspaceRoot / "versions.json")
def sharedDependencies: T[SharedDependencies] = Task {
  val jsonStr = os.read(versionsFile().path)
  decode[Map[String, Map[String, String]]](jsonStr) match {
    case Left(error)        => throw new IllegalArgumentException(s"Could not read versions.json: ${error.getMessage}", error)
    case Right(versionMaps) =>
      val flat = versionMaps.values.flatten.toMap
      new SharedDependencies(flat)
  }
}
