package build.database

import mill._, mill.scalalib._
import build.modules.{BaseModule, SharedDependencies}

object `package` extends BaseModule {
  override def moduleName                                       = "database"
  override def isComponent: Boolean                             = false
  override def dependencies(deps: SharedDependencies): Seq[Dep] = deps.logging ++ deps.database ++
    Seq(deps.jsoup, deps.scalaUri)
  override def moduleDeps: Seq[JavaModule] = Seq(build.common, build.network)
  object test extends TestBase {
    override def moduleDeps = super.moduleDeps ++ Seq(build.scalatestsuite)
  }
}
