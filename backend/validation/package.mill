package build.validation

import mill._, mill.scalalib._
import build.modules.{BaseModule, SharedDependencies}

object `package` extends BaseModule {
  override def moduleName                                       = "validation"
  override def isComponent                                      = false
  override def dependencies(deps: SharedDependencies): Seq[Dep] = deps.logging ++ Seq(deps.jsoup, deps.scalaUri)
  override def moduleDeps                                       = Seq(build.common)
  object test extends TestBase
}
