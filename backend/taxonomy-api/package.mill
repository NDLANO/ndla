package build.`taxonomy-api`

import mill.*
import mill.api.BuildCtx
import mill.scalalib.*
import build.modules.{JavaBaseModule, JavaDockerComponent, SharedDependencies, sharedDependencies}

object `package` extends JavaBaseModule, JavaDockerComponent {
  override def moduleName: String           = "taxonomy-api"
  override def mainClass: T[Option[String]] = Task {
    Some("no.ndla.taxonomy.TaxonomyApplication")
  }

  // Resources live in `compile-resources/` (Mill's `compileResources` task), not the
  // standard `src/main/resources/`. Rationale: IntelliJ's BSP integration exposes
  // `src/main/resources` as a "java-resource" source folder AND the merged compile
  // output (bspBuildTargetCompileMerged.dest) which also contains those files — so
  // every resource appears twice on the runtime classpath and Liquibase fails on the
  // duplicates. `compile-resources` is exposed as a single library entry instead,
  // giving each file exactly one classpath location.
  override def resources: T[Seq[PathRef]] = Task {
    Seq.empty[PathRef]
  }

  override def compileResources: T[Seq[PathRef]] =
    Task.Sources("compile-resources", BuildCtx.workspaceRoot / "log4j" / "main")

  override def boms(deps: SharedDependencies): Seq[Dep] = deps.springBootBoms

  // The Spring Boot BOM pins an older log4j than the Scala backends we share `log4j2.yaml` with.
  override def depManagement: T[Seq[Dep]] = Task {
    super.depManagement() ++ sharedDependencies().log4j
  }

  override def dependencies(deps: SharedDependencies): Seq[Dep] = (deps.springBootStarters ++ deps.taxonomyExtras).map(
    withoutLogback
  )

  private def withoutLogback(dep: Dep): Dep = dep.exclude("org.springframework.boot" -> "spring-boot-starter-logging")

  // The `typescript` Spring profile points at `jdbc:tc:postgresql://...`, which needs
  // testcontainers' JDBC driver on the runtime classpath. Those are test-scoped, so
  // bring them in only for the OpenAPI→TS generation task.
  override def openApiExtraRunClasspath: T[Seq[PathRef]] = Task {
    test.runClasspath()
  }

  object test extends TestBase {
    override def testBoms(deps: SharedDependencies): Seq[Dep]         = deps.springBootBoms
    override def testDependencies(deps: SharedDependencies): Seq[Dep] = deps.springBootTest.map(withoutLogback)
  }
}
