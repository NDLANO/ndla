package build.`draft-api`

import mill._, mill.scalalib._
import build.modules.{BaseModule, DockerComponent, SharedDependencies}

object `package` extends BaseModule, DockerComponent {
  override def moduleName                                       = "draft-api"
  override def dependencies(deps: SharedDependencies): Seq[Dep] = deps.logging ++
    deps.enumeratum ++
    deps.tapirCirce ++
    deps.database ++
    Seq(deps.scalaUri, deps.sttp, deps.jsoup, deps.catsEffect, deps.awsS3)
  override def moduleDeps =
    Seq(build.common, build.network, build.mapping, build.language, build.validation, build.search, build.database)
  object test extends TestBase {
    override def moduleDeps = super.moduleDeps ++ Seq(build.tapirtesting, build.scalatestsuite)
  }
}
