{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "plugins": [
    {
      "plugin": "@ndla/nx-mill",
      "include": ["backend/**"]
    }
  ],
  "tui": {
    "autoExit": true,
    "enabled": true
  },
  "parallel": 8,
  "targetDefaults": {
    "//": "Keyed by executor, which nx resolves in preference to the target-name keys below (see readTargetDefaultsForTarget). Mill targets are the only nx:run-commands targets in the workspace, so this scopes the frontend-shaped defaults away from them: without it, `nx test article-api` would inherit `test`'s panda-codegen dependsOn and cache:true. Mill keeps its own incremental state, so nx must not cache these. parallelism:false is required, not a tuning knob: concurrent Mill launchers each spawn a daemon, each new daemon evicts the previous one's daemonLock, and clients attached to an evicted daemon die with `Worker wire broken, worker likely crashed`. Mill serializes the real work on a workspace lock anyway, so one client at a time costs nothing but the lost overlap with frontend tasks.",
    "nx:run-commands": {
      "cache": false,
      "parallelism": false
    },
    "codegen": {
      "dependsOn": [
        {
          "projects": ["@ndla/core"],
          "target": "build"
        }
      ],
      "inputs": ["production", "^production"],
      "outputs": [
        "{workspaceRoot}/frontend/packages/packages/styled-system/src/**/*",
        "{workspaceRoot}/frontend/packages/packages/styled-system/lib/**/*.d.ts"
      ],
      "cache": true
    },
    "build": {
      "dependsOn": [
        "^build",
        "^build:panda",
        {
          "projects": ["@ndla/preset-panda"],
          "target": "codegen"
        }
      ],
      "inputs": ["production", "^production"],
      "outputs": [
        "{projectRoot}/lib/**/*.js",
        "{projectRoot}/lib/**/*.js.map",
        "{projectRoot}/es/**/*.mjs",
        "{projectRoot}/es/**/*.mjs.map"
      ],
      "cache": true
    },
    "build:types": {
      "dependsOn": [
        "^build:types",
        {
          "projects": ["@ndla/preset-panda"],
          "target": "codegen"
        }
      ],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/lib/**/*.d.ts"],
      "cache": true
    },
    "build:panda": {
      "dependsOn": [
        {
          "projects": ["@ndla/preset-panda"],
          "target": "codegen"
        },
        {
          "projects": ["@ndla/preset-panda"],
          "target": "build"
        }
      ],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist/**/*"],
      "cache": true
    },
    "type-check": {
      "dependsOn": [
        {
          "projects": ["@ndla/preset-panda"],
          "target": "codegen"
        }
      ],
      "inputs": ["default", "^production"],
      "cache": true
    },
    "test": {
      "dependsOn": [
        {
          "projects": ["@ndla/preset-panda"],
          "target": "codegen"
        }
      ],
      "inputs": ["default", "^production"],
      "cache": true
    },
    "lint-es": {
      "inputs": ["default", "^production"],
      "outputs": ["{projectRoot}/.eslintcache"],
      "cache": true
    },
    "format-check": {
      "inputs": ["default"],
      "cache": true
    },
    "watch:types": {
      "dependsOn": [
        {
          "projects": ["@ndla/preset-panda"],
          "target": "codegen"
        }
      ],
      "cache": false,
      "continuous": true
    },
    "watch:panda": {
      "dependsOn": ["build:panda", "^watch:panda"],
      "cache": false,
      "continuous": true
    },
    "watch:js": {
      "dependsOn": ["build", "^watch:js"],
      "cache": false,
      "continuous": true
    },
    "watch:codegen": {
      "dependsOn": ["codegen", "^watch:codegen"],
      "cache": false,
      "continuous": true
    },
    "dev": {
      "dependsOn": ["watch:types", "^watch:panda", "^watch:js", "^watch:codegen"],
      "cache": false,
      "continuous": true
    }
  },
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/pnpm-workspace.yaml",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/tsconfig.app.json",
      "{workspaceRoot}/frontend/packages/tsconfig.json",
      "{workspaceRoot}/frontend/packages/tsconfig.build.json",
      "{workspaceRoot}/frontend/packages/tsdown.config.mts",
      "{workspaceRoot}/frontend/packages/panda.config.ts"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/__tests__/**/*",
      "!{projectRoot}/**/*-test.{js,jsx,ts,tsx}",
      "!{projectRoot}/**/*.stories.{js,jsx,ts,tsx}",
      "!{projectRoot}/e2e/**/*",
      "!{projectRoot}/**/*.md"
    ]
  },
  "analytics": false
}
